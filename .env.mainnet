# ============================================================================
# PRODUCTION ENV. THIS is what ships to Play Store + App Store.
#
# Consumed by:
#   - iOS scheme TuCop-mainnet (the ONLY scheme allowed for archives)
#   - Android flavor mainnet (bundleMainnetRelease)
#   - CI Build workflow on main branch
#
# Before any release archive, copy this to .env so react-native-config
# reads the right values:
#     cp .env.mainnet .env
# Then run:
#     yarn preflight:ios-release   # bails if anything is off
#     (do the Xcode Archive)
#     yarn validate:ios-archive    # bails if the archive is wrong flavor
# ============================================================================
# Generated using co.clabs.valora and the matching signing cert from the Play Store
# This means Android auto-read feature will only work from Play Store distributed builds!
SMS_RETRIEVER_APP_SIGNATURE=bU9E4ctGtIW
# Selects which key in secrets.json the Xcode pre-action loads. Mainnet is the
# only supported network after PR #162 removed Sepolia, but build scripts
# (xcode_scheme_build_pre_action.sh, run_app.sh) still index by this var.
DEFAULT_TESTNET=mainnet
DEV_SETTINGS_ACTIVE_INITIALLY=false
APP_BUNDLE_ID=org.tucop
APP_STORE_ID=6742667119
APP_DISPLAY_NAME=TuCop
IOS_GOOGLE_SERVICE_PLIST=GoogleService-Info.mainnet.plist
SENTRY_ENABLED=true
AUTH0_DOMAIN=auth.valora.xyz
ONBOARDING_FEATURES_ENABLED=EnableBiometry,ProtectWallet
DEEP_LINK_URL_SCHEME=myapp
# APP_REGISTRY_NAME should not contain spaces, it is used for the app buildable name and user agent header
APP_REGISTRY_NAME=TuCop
