0442\u0430 \u043d\u0430 \u0444\u0456\u043b\u044c\u0442\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u043e\u043c\u0435\u0440\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0430",body2SaltQuotaExceeded:"\u041f\u0440\u043e\u0441\u0438\u043c\u043e \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 \u0449\u0435 \u0440\u0430\u0437, \u043a\u043e\u043b\u0438 \u043f\u0440\u0438\u0434\u0431\u0430\u0454\u0442\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 \u0444\u0456\u043b\u044c\u0442\u0440\u0443\u0432\u0430\u043d\u044c",enterCodesBody:"\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u043e\u0442\u0440\u0438\u043c\u0430\u043b\u0438 \u0447\u0435\u0440\u0435\u0437 SMS \u0442\u0440\u0438 \u043a\u043e\u0434\u0438, \u0432\u0438 \u0432\u0441\u0435 \u0449\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0432\u0435\u0441\u0442\u0438 \u0457\u0445.",enterCodesButton:"\u0412\u0432\u0435\u0441\u0442\u0438 \u043a\u043e\u0434\u0438"},retryWithFornoModal:{header:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438 \u0437\u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f\u043c \u0434\u0430\u043d\u0438\u0445?",body1:"\u041f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u043d\u043e\u043c\u0435\u0440\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0432\u0438\u043d\u0438\u043a\u043b\u0430 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430. \u041c\u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u043c\u043e \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 \u0449\u0435 \u0440\u0430\u0437 \u0437 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u0438\u043c \u0440\u0435\u0436\u0438\u043c\u043e\u043c \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445.",body2:"\u0423 \u0440\u0435\u0436\u0438\u043c\u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445 \u0437\u0432\u2019\u044f\u0437\u043e\u043a \u0456\u0437 \u043c\u0435\u0440\u0435\u0436\u0435\u044e \u0441\u0442\u0430\u043d\u0435 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0456\u0448\u0438\u043c \u0437\u0430\u0432\u0434\u044f\u043a\u0438 \u043d\u0430\u0434\u0456\u0439\u043d\u043e\u043c\u0443 \u0437\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044e.",retryButton:"\u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0438 \u0437 \u0440\u0435\u0436\u0438\u043c\u043e\u043c \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445"},congratsVerified:"\u0412\u0456\u0442\u0430\u0454\u043c\u043e, \u0432\u0430\u0448 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043e!",notification:{body:"\u041f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438 \u0441\u0432\u0456\u0439 \u043d\u043e\u043c\u0435\u0440, \u0449\u043e\u0431 \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0448\u0442\u0438 \u0442\u0430 \u0437\u0432'\u044f\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u0437 \u0434\u0440\u0443\u0437\u044f\u043c\u0438",cta:"\u041f\u0456\u0434'\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0437\u0430\u0440\u0430\u0437"},quotaLookup:{title:"\u041f\u0435\u0440\u0435\u0432\u0438\u0449\u0435\u043d\u043e \u043a\u0432\u043e\u0442\u0443 \u0434\u043b\u044f \u0444\u0456\u043b\u044c\u0442\u0440\u0443\u0432\u0430\u043d\u043d\u044f",body1:"\u0429\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0432\u0430\u0448 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0438\u043c, {{appName}} \u043e\u0431\u043c\u0435\u0436\u0443\u0454 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u0438\u0445 \u043d\u043e\u043c\u0435\u0440\u0456\u0432.",body2:"\u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0440\u0438\u0434\u0431\u0430\u0442\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u0444\u0456\u043b\u044c\u0442\u0440\u0443\u0432\u0430\u043d\u044c \u0437\u0430 \u043d\u0435\u0432\u0435\u043b\u0438\u043a\u0443 \u043f\u043b\u0430\u0442\u0443.",cta:"\u041f\u0440\u0438\u0434\u0431\u0430\u0442\u0438 \u0444\u0456\u043b\u044c\u0442\u0440\u0443\u0432\u0430\u043d\u043d\u044f (2)"},onboardingEducation:{step1:"\u042f\u043a\u0449\u043e \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 SMS, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044c \u043a\u0440\u0438\u043f\u0442\u043e\u044e. \u0422\u0435\u043f\u0435\u0440 \u0432\u0430\u0448 \u0442\u0435\u043b\u0435\u0444\u043e\u043d - \u0432\u0430\u0448 \u043a\u0440\u0438\u043f\u0442\u043e \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c.",step2:"\u0417 {{appName}} \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0442\u0430 \u0456\u043d\u0432\u0435\u0441\u0442\u0443\u0432\u0430\u0442\u0438 \u0432 \u043a\u0440\u0438\u043f\u0442\u0443 - \u043b\u0435\u0433\u043a\u043e.",step3:"\u0412\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u043b\u0438\u0448\u0435 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d, \u0449\u043e\u0431 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438, \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0442\u0438 \u0442\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0441\u044c \u043a\u0440\u0438\u043f\u0442\u043e.",payment:"\u041d\u0430\u0434\u0441\u0438\u043b\u0430\u0439\u0442\u0435 \u043f\u043b\u0430\u0442\u0435\u0436\u0456 \u043f\u043e \u0432\u0441\u044c\u043e\u043c\u0443 \u0441\u0432\u0456\u0442\u0443 \u0437 \u043c\u0430\u0439\u0436\u0435 \u043d\u0443\u043b\u044c\u043e\u0432\u043e\u044e \u043a\u043e\u043c\u0456\u0441\u0456\u0454\u044e",impact:"\u041f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0439\u0442\u0435 \u0456\u043d\u0456\u0446\u0456\u0430\u0442\u0438\u0432\u0438 \u0449\u043e\u0434\u043e \u043a\u043b\u0456\u043c\u0430\u0442\u0443 \u0442\u0430 \u0441\u043e\u0446\u0456\u0430\u043b\u044c\u043d\u0438\u0445 \u0437\u043c\u0456\u043d",spend:"\u041a\u0443\u043f\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0457 \u0443\u043b\u044e\u0431\u043b\u0435\u043d\u0456 \u0431\u0440\u0435\u043d\u0434\u0438 \u0437\u0430 \u043a\u0440\u0438\u043f\u0442\u043e\u0432\u0430\u043b\u044e\u0442\u0443"},enableBiometry:{title:"\u0417\u0430\u0445\u0438\u0441\u0442\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",description:"{{biometryType}} \u0437\u0430\u0445\u0438\u0449\u0430\u0454 \u0432\u0430\u0448 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c \u0456 \u043f\u043e\u043b\u0435\u0433\u0448\u0443\u0454 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f {{appName}}",cta:"\u0423\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 {{biometryType}}",guideTitle:"\u0411\u0430\u0436\u0430\u0454\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u0438 {{biometryType}}?",guideDescription:"{{biometryType}} \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u0441\u043f\u0440\u043e\u0441\u0442\u0438\u0442\u0438, \u043f\u0440\u0438\u0448\u0432\u0438\u0434\u0448\u0438\u0442\u0438 \u0439 \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u0456\u0448\u0438\u043c \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u0433\u0430\u043c\u0430\u043d\u0446\u044f \u0434\u043e \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u0439 \u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0430\u0445 dapps \u0456\u0437 \u043f\u0456\u0434\u043f\u0438\u0441\u043e\u043c."},biometryType:{FaceID:"\u0406\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 \u043e\u0431\u043b\u0438\u0447\u0447\u044f",TouchID:"\u0406\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 \u0434\u043e\u0442\u0438\u043a\u0443",Fingerprint:"\u0420\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0432\u0456\u0434\u0431\u0438\u0442\u043a\u0443 \u043f\u0430\u043b\u044c\u0446\u044f",Face:"\u0420\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043e\u0431\u043b\u0438\u0447\u0447\u044f",Iris:"\u0420\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0440\u0430\u0439\u0434\u0443\u0436\u043d\u043e\u0457 \u043e\u0431\u043e\u043b\u043e\u043d\u043a\u0438"},useBiometryType:"\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438 {{biometryType}}",unlockWithBiometryPrompt:"\u0410\u0432\u0442\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0443\u0439\u0442\u0435\u0441\u044f \u0434\u043b\u044f \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f {{appName}}",welcome:{title:"\u041a\u0440\u043e\u043a \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u0454 \u043a\u0440\u0438\u043f\u0442\u043e\u0432\u0430\u043b\u044e\u0442\u0438 \u0437 {{appName}}",titleGuided:"\u041b\u0430\u0441\u043a\u0430\u0432\u043e \u043f\u0440\u043e\u0441\u0438\u043c\u043e \u0434\u043e {{appName}}!\n\u0421\u0442\u0432\u043e\u0440\u0456\u043c\u043e \u0432\u0430\u0448 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c.",createAccount:"\u0421\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043d\u043e\u0432\u0438\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441",restoreAccount:"\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u043c\u0456\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441",createNewWallet:"\u0421\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",restoreWallet:"\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",hasWallet:"\u0423 \u043c\u0435\u043d\u0435 \u0432\u0436\u0435 \u0454 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",hasWalletV1_88:"\u0423 \u043c\u0435\u043d\u0435 \u0454 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",header:"\u041b\u0430\u0441\u043a\u0430\u0432\u043e \u043f\u0440\u043e\u0441\u0438\u043c\u043e \u0434\u043e {{appName}}! \u0421\u0442\u0432\u043e\u0440\u0456\u043c\u043e \u0432\u0430\u0448 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c.",getStarted:"\u041f\u043e\u0447\u0430\u0442\u0438 \u0440\u043e\u0431\u043e\u0442\u0443",agreeToTerms:"\u042f\u043a\u0449\u043e \u0432\u0438 \u0441\u0442\u0432\u043e\u0440\u044e\u0454\u0442\u0435 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c, \u0442\u043e \u043f\u043e\u0433\u043e\u0434\u0436\u0443\u0454\u0442\u0435\u0441\u044f \u0437 \u043d\u0430\u0448\u0438\u043c\u0438 <0>\u0423\u043c\u043e\u0432\u0430\u043c\u0438 \u043d\u0430\u0434\u0430\u043d\u043d\u044f \u043f\u043e\u0441\u043b\u0443\u0433</0>"},accessContacts:{disclosure:{title:"\u0406\u043c\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0438",body:"{{appName}} \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0454 \u0456\u043c\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0438. \u041d\u0430\u0442\u0438\u0441\u043a\u0430\u044e\u0447\u0438 \u043d\u0438\u0436\u0447\u0435, \u044f \u043d\u0430\u0434\u0430\u044e \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043d\u043e\u043c\u0435\u0440\u0456\u0432 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456\u0432, \u0456\u043c\u0435\u043d \u0456 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0456\u0439 \u043c\u043e\u0457\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0456\u0432 \u0434\u043b\u044f \u0437\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0437 \u043