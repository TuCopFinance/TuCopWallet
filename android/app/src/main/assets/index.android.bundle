}},ctaV1_86:{title:"Maksymalizuj zarobki na stablecoinach",subtitle:"Kup {{symbol}}",description:"Zarabiaj oko\u0142o {{apy}}% rocznie, dodaj\u0105c {{symbol}} do puli"},entrypoint:{title:"Zarabiaj na swoich kryptowalutach",subtitle:"Wp\u0142acaj i zarabiaj",description:"Zarabiaj, po\u017cyczaj\u0105c swoje aktywa krytpowalutowe w pulach p\u0142ynno\u015bci.",totalDepositAndEarnings:"Suma wp\u0142at i zarobk\xf3w"},enterAmount:{title:"Ile chcesz wp\u0142aci\u0107?",titleWithdraw:"Ile chcesz wyp\u0142aci\u0107?",deposit:"Wp\u0142at\u0119",fees:"Op\u0142aty",available:"Dost\u0119pne",swap:"Zamieniaj",claimingReward:"Odbieranie nagrody",earnUpToLabel:"Mo\u017cesz zarobi\u0107 do:",rateLabel:"Stawka (szac.)",earnUpTo:"~{{amount}}{{fiatSymbol}} / rok",earnUpToV1_87:"<0></0> / rok",rate:"{{rate}}% APY",continue:"Kontynuuj",info:"Ta pula jest zapewniana przez Aave",infoV1_93:"Obs\u0142ugiwane przez {{providerName}}",notEnoughBalanceForGasWarning:{title:"Potrzebujesz wi\u0119cej {{feeTokenSymbol}}, aby kontynuowa\u0107",description:"Dodaj {{feeTokenSymbol}} w {{network}}, aby pokry\u0107 op\u0142aty za gaz",noGasCta:"Kup {{feeTokenSymbol}} w {{network}}"},feeBottomSheet:{feeDetails:"Dane op\u0142at",moreInformation:"Wi\u0119cej informacji",estNetworkFee:"Szac. op\u0142ata sieciowa",maxNetworkFee:"Maksymalna op\u0142ata sieciowa",networkFeeDescription:"Nale\u017cy wnie\u015b\u0107 op\u0142at\u0119 sieciow\u0105, aby sie\u0107 mog\u0142a przetworzy\u0107 transakcj\u0119 wp\u0142aty.",networkFeeDescriptionWithdrawal:"Nale\u017cy wnie\u015b\u0107 op\u0142at\u0119 sieciow\u0105, aby sie\u0107 mog\u0142a przetworzy\u0107 transakcj\u0119 wyp\u0142aty.",networkSwapFeeDescription:"Nale\u017cy wnie\u015b\u0107 op\u0142at\u0119 sieciow\u0105, aby sie\u0107 mog\u0142a przetworzy\u0107 transakcje wp\u0142aty. Op\u0142ata {{appName}} w wysoko\u015bci {{appFeePercentage}}% jest pobierana za korzystanie z naszego produktu.",appSwapFee:"Op\u0142ata w aplikacji {{appName}}"},swapBottomSheet:{swapDetails:"Dane wymiany",swapFrom:"Zamie\u0144 z",swapTo:"Zamie\u0144 na",whySwap:"Dlaczego dokonuj\u0119 wymiany?",swapDescription:"Aby mo\u017cna by\u0142o wp\u0142aci\u0107 \u015brodki do puli, token jest wymieniany na token puli."},withdrawingAndClaimingCard:{title:"Wyp\u0142aty i odbieranie",description:"{{providerName}} wymaga odebrania wszystkich dost\u0119pnych nagr\xf3d przy ka\u017cdej wyp\u0142acie."}},activePools:{title:"Aktywne pule",totalValue:"Warto\u015b\u0107 ca\u0142kowita:",apy:"~{{apy}}% APY",exitPool:"Wyjd\u017a z puli",depositMore:"Wp\u0142a\u0107 wi\u0119cej",viewPools:"Poka\u017c pule",poolsSupplied:"Dost\u0119pne pule",totalSupplied:"Dost\u0119pne og\xf3\u0142em",depositAndEarnings:"Wp\u0142aty i zarobki",myPools:"Moje pule",explore:"Przegl\u0105daj otwarte"},depositBottomSheet:{title:"Przegl\u0105d i wp\u0142ata",description:"Przed dokonaniem wp\u0142aty do puli Aave zapoznaj si\u0119 z poni\u017cszymi szczeg\xf3\u0142ami transakcji",descriptionV1_93:"Przed dokonaniem wp\u0142aty do puli {{providerName}} zapoznaj si\u0119 z poni\u017cszymi szczeg\xf3\u0142ami transakcji",amount:"Kwota wp\u0142acona",fee:"Szac. op\u0142aty za gaz",provider:"Dostawca zarobk\xf3w",network:"Sie\u0107",footer:"Wp\u0142acaj\u0105c kryptowaluty do puli Aave, akceptujesz ryzyko zwi\u0105zane z korzystaniem z Aave. <0>Warunki</0>",footerV1_93:"Wp\u0142acaj\u0105c kryptowaluty do puli {{providerName}}, akceptujesz ryzyko zwi\u0105zane z korzystaniem z {{providerName}}. <0>Warunki</0>",noTermsUrlFooter:"Ponosisz odpowiedzialno\u015b\u0107 za swoje dzia\u0142ania w aplikacji {{appName}}. Producent aplikacji {{appName}} zrzeka si\u0119 wszelkiej odpowiedzialno\u015bci za Twoje aktywa lub interakcje z dostawc\u0105 {{providerName}}. Mo\u017cesz zapozna\u0107 si\u0119 z dokumentami dostawcy {{providerName}} <0>tutaj</0>, a naszymi warunkami <1>tutaj</1>.",primaryCta:"Zako\u0144cz",secondaryCta:"Anuluj",yieldRate:"Stopa zwrotu (szac.)",apy:"{{apy}}%"},collect:{title:"Gratulacje! Przejrzyj i odbierz swoje zarobki",titleClaim:"Zamierzasz odebra\u0107:",titleCollect:"Zamierzasz zebra\u0107:",titleWithdraw:"Zamierzasz wyp\u0142aci\u0107:",total:"RAZEM",plus:"PLUS",reward:"NAGRODA",rate:"Stawka (szac.)",apy:"{{apy}}% APY",fee:"Op\u0142ata za gaz",cta:"Zbieraj zarobki",ctaWithdraw:"Wycofaj",ctaReward:"Odbierz nagrod\u0119",ctaExit:"Wyjd\u017a z puli",errorTitle:"Co\u015b posz\u0142o nie tak",errorDescription:"Nie mo\u017cna pobra\u0107 szczeg\xf3\u0142\xf3w wp\u0142aty. Spr\xf3buj ponownie.",noGasTitle:"Potrzebujesz wi\u0119cej {{symbol}}, aby kontynuowa\u0107",noGasDescription:"Dodaj {{symbol}} w {{network}}, aby pokry\u0107 op\u0142aty za gaz",noGasCta:"Kup {{symbol}} w {{network}}"},transactionFeed:{earnClaimTitle:"Zebrano",earnClaimSubtitle:"z puli {{providerName}}",earnDepositTitle:"Wp\u0142acono",earnDepositSubtitle:"do puli {{providerName}}",earnWithdrawTitle:"Wycofano",earnWithdrawSubtitle:"z puli {{providerName}}"},transactionDetails:{descriptionLabel:"Szczeg\xf3\u0142y",earnClaimTitle:"Zebrano",earnClaimSubtitle:"Zebrano {{tokenSymbol}} z puli {{providerName}}",earnClaimDetails:"Zebrana kwota",earnDepositTitle:"Wp\u0142acono",earnDepositSubtitle:"Wp\u0142acono {{tokenSymbol}} do puli {{providerName}}",earnDepositDetails:"Kwota wp\u0142acona",earnWithdrawTitle:"Wycofano",earnWithdrawSubtitle:"Wycofano {{tokenSymbol}} z puli {{providerName}}",earnWithdrawDetails:"Wyp\u0142acona kwota",swap:"Zamieniaj",network:"Sie\u0107",fees:"Op\u0142aty"},home:{title:"Zarabiaj",learnMore:"<0>Dowiedz si\u0119 wi\u0119cej</0> o pulach zysku.",learnMoreBottomSheet:{bottomSheetTitle:"Dowiedz si\u0119 wi\u0119cej o pulach zysku",apySubtitle:"Co to jest APY?",apyDescription:"Roczny zysk procentowy (APY) jest wska\u017anikiem u\u017cywanym do obliczania rocznego zwrotu z inwestycji w kryptowaluty. To kluczowy wska\u017anik potencjalnego zwrotu i rentowno\u015bci kryptowaluty.",tvlSubtitle:"Co to jest TVL?",tvlDescription:"TVL to skr\xf3t oznaczaj\u0105cy \u0142\u0105czn\u0105 warto\u015b\u0107 zablokowanych aktyw\xf3w i jest wska\u017anikiem u\u017cywanym w bran\u017cy kryptowalut do pomiaru warto\u015bci cyfrowych aktyw\xf3w zablokowanych w sieci \u0142a\u0144cucha blok\xf3w. Oblicza si\u0119 go przez zsumowanie warto\u015bci wszystkich cyfrowych aktyw\xf3w zablokowanych w protokole DeFi lub inteligentnym kontrakcie. \u015arodkami s\u0105 mi\u0119dzy innymi kryptowaluty, tokeny p\u0142atnicze i inne tokeny.",yieldPoolSubtitle:"Czym jest pula zysk\xf3w?",yieldPoolDescription:"Pule zysk\xf3w lub pule p\u0142ynno\u015bci to po\u0142\u0105czone fundusze udost\u0119pniane przez posiadaczy token\xf3w, kt\xf3re umo\u017cliwiaj\u0105 handel na zdecentralizowanych gie\u0142dach. Staj\u0105c si\u0119 uczestnikiem puli, b\u0119dziesz dostawa\u0107 odsetki od innych os\xf3b, kt\xf3re po\u017cyczaj\u0105 te \u015brodki.",chooseSubtitle:"Jak wybra\u0107 pul\u0119? ",chooseDescription:"Ka\u017cda decyzja finansowa jest osobistym wyborem. Zebrali\u015bmy wybrane pule z r\xf3\u017cnych protoko\u0142\xf3w, ale ka\u017cda pula zapewnia inne korzy\u015bci i wi\u0105\u017ce si\u0119 z innym ryzykiem. Dok\u0142adamy wszelkich stara\u0144, aby zapewni\u0107 przydatne informacje o wszystkich pulach, ale lepiej zrobi\u0107 w\u0142asne rozeznanie w razie jakichkolwiek w\u0105tpliwo\u015bci."},noPoolsTitle:"Nie do\u0142\u0105czono jeszcze do \u017cadnej puli",noPoolsDescription:"Odkryj dost\u0119pne pule, wybierz tak\u0105, kt\xf3ra odpowiada Twoim celom, i w pe\u0142ni wykorzystaj swoje kryptowaluty.",errorTitle:"Nie mo\u017cna wczyta\u0107 pul",errorDescription:"Wyst\u0105pi\u0142 b\u0142\u0105d podczas pr\xf3by wczytania informacji o puli. Spr\xf3buj ponownie.",errorButton:"Spr\xf3buj ponownie"},poolCard:{onNetwork:"w {{networkName}}",rate:"Stawka (szac.)",yieldRate:"Stopa zwrotu (szac.)",reward:"Nagroda",tvl:"TVL",exitPool:"Wyjd\u017a z puli",addToPool:"Dodaj do puli",apy:"{{apy}}% APY",percentage:"{{percentage}}%",poweredBy:"Obs\u0142ugiwane przez {{providerName}}",deposited:"Dostarczone",depositAndEarnings:"Wp\u0142aty i zarobki"},poolFilters:{allPools:"Wszystkie pule",myPools:"Moje pule"},poolInfoScreen:{chainName:"\u0141a\u0144cuch: <0>{{networkName}}</0>",protocolName:"Protok\xf3\u0142: <0>{{providerName}}</0>",yieldRate:"Stopa zwrotu",dailyYieldRate:"Dzienna stopa zwrotu",ratePercent:"{{rate}}%",rewards:"Nagrody",noRewards:"Brak nagr\xf3d",safetyScore:"Ocena bezpiecze\u0144stwa",tvl:"TVL",ageOfPool:"Wiek puli",learnMoreOnProvider:"Wy\u015bwietl pul\u0119 w {{providerName}}",deposit:"Wp\u0142at\u0119",depositAndEarnings:"Wp\u0142aty i zarobki",withdraw:"Wycofaj",withdrawBottomSheet:{title:"Wybierz typ wyp\u0142aty",withdrawAndClaim:"Wyp\u0142a\u0107 i odbierz",withdrawDescription:"Wyp\u0142a\u0107 okre\u015blon\u0105 kwot\u0119 dowolnych zdeponowanych w puli token\xf3w",withdrawAndClaimRewardsDescription:"Wyp\u0142a\u0107 okre\u015blon\u0105 kwot\u0119 dowolnych zdeponowanych w puli token\xf3w i automatycznie odbierz swoje nagrody",withdrawAndClaimEarningsDescription:"Wyp\u0142a\u0107 okre\u015blon\u0105 kwot\u0119 dowolnych zdeponowanych w puli token\xf3w i automatycznie odbierz swoje zarobki",claimRewards:"Odbierz nagrody",claimRewardsDescription:"Odbierz swoje nagrody. Nie mo\u017cna odebra\u0107 cz\u0119\u015bciowej kwoty nagrody",claimEarnings:"Odbierz zarobki",claimEarningsDescription:"Odbierz zarobki z depozytu. Nie mo\u017cna odebra\u0107 kwot cz\u0119\u015bciowych",exit:"Zako\u0144cz",exitDescription:"Zako\u0144czenie spowoduje wyp\u0142at\u0119 wszystkich \u015brodk\xf3w z puli",exitWithRewardsDescription:"Zako\u0144czenie spowoduje wyp\u0142at\u0119 wszystkich \u015brodk\xf3w z puli, w tym nagr\xf3d",exitWithEarningsDescription:"Zako\u0144czenie spowoduje wyp\u0142at\u0119 wszystkich \u015brodk\xf3w z puli, w tym zarobk\xf3w"},totalDepositAndEarnings:"Suma wp\u0142at i zarobk\xf3w",titleLocalAmountDisplay:"{{localCurrencySymbol}}{{localCurrencyAmount}}",lineItemAmountDisplay:"{{localCurrencySymbol}}{{localCurrencyAmount}} ({{cryptoAmount}} {{cryptoSymbol}})",infoBottomSheet:{gotIt:"Rozumiem",depositDescription:"Jest to zestawienie zdeponowanej kwoty, uzyskanych odsetek od tej kwoty oraz wszelkich dodatkowych korzy\u015bci zwi\u0105zanych z udzia\u0142em w puli.",depositNoBreakdownDescription:"Ta liczba obejmuje dostarczone tokeny oraz wszystkie zarobione odsetki i korzy\u015bci.\n\nNiekt\xf3re protoko\u0142y, takie jak {{providerName}}, nie oferuj\u0105 zestawie\u0144 zarobk\xf3w. Jest to ca\u0142kowicie normalne. Zamiast tego dodaj\u0105 zarobki bezpo\u015brednio do zdeponowanej kwoty, co daje jeszcze wi\u0119ksze odsetki w kolejnych okresach. ",tvlTitle:"Ca\u0142kowita warto\u015b\u0107 zablokowana (TVL)",tvlDescription:"Wska\u017anik TVL odnosi si\u0119 do \u0142\u0105cznej warto\u015bci aktyw\xf3w wp\u0142aconych do puli p\u0142ynno\u015bci. Mo\u017cna go u\u017cywa\u0107 do wskazywania zaufania i przydatno\u015bci puli. Zwykle im wy\u017cszy wska\u017anik TVL, tym ni\u017csze ryzyko, ale \u017cadna pula nie jest ca\u0142kowicie pozbawiona ryzyka.",ageTitle:"Wiek puli",ageDescription:"Starsze pule p\u0142ynno\u015bci mog\u0105 mie\u0107 dobre referencje i cieszy\u0107 si\u0119 zaufaniem spo\u0142eczno\u015bci. Ze wzgl\u0119du na to niekt\xf3re osoby mog\u0105 uznawa\u0107 te pule za bezpieczniejsze.\n\nNie ma idealnego sposobu na okre\u015blanie ryzyka, dlatego wykorzystaj te informacje w swoich og\xf3lnych badaniach, aby podj\u0105\u0107 najlepsz\u0105 dla siebie decyzj\u0119.",yieldRateTitle:"Stopa zwrotu",yieldRateDescription:"Wi\u0119kszo\u015b\u0107 pul oferuje zarobki w postaci token\xf3w pul p\u0142ynno\u015bci. Niekt\xf3re z nich oferuj\u0105 dodatkowe tokeny jako nagrody lub dodatkowe zach\u0119ty.\n\nAplikacja {{appName}} agreguje pule z wielu protoko\u0142\xf3w, dlatego po\u0142\u0105czyli\u015bmy wszystkie stawki zarobk\xf3w i nagr\xf3d w pojedyncz\u0105, og\xf3ln\u0105 stawk\u0119 zysku, kt\xf3ra u\u0142atwia ocen\u0119 potencja\u0142u zarobk\xf3w. Warto\u015b\u0107 ta jest tylko szacunkiem, gdy\u017c warto\u015bci zarobk\xf3w i nagr\xf3d nie s\u0105 sta\u0142e.\n\nWi\u0119cej informacji o podziale zysk\xf3w mo\u017cesz uzyska\u0107, odwiedzaj\u0105c stron\u0119 <0>{{providerName}}</0>.",dailyYieldRateTitle:"Dzienna stopa zwrotu",dailyYieldRateDescription:"Wy\u015bwietlana dzienna stopa zwrotu odzwierciedla dzienn\u0105 stop\u0119 zwrotu oferowan\u0105 przez {{providerName}}.",dailyYieldRateLink:"Zobacz wi\u0119cej szczeg\xf3\u0142\xf3w na temat dziennych st\xf3p zwrotu na stronie {{providerName}}",safetyScoreTitle:"Ocena bezpiecze\u0144stwa",safetyScoreDescription:"Ocena bezpiecze\u0144stwa dzieli bezpiecze\u0144stwo aktyw\xf3w w sejfie na kilka kluczowych czynnik\xf3w. Jej celem jest zwr\xf3cenie uwagi u\u017cytkownika na ryzyko, jakie nale\u017cy wzi\u0105\u0107 pod uwag\u0119 przed dokonaniem inwestycji, a tak\u017ce poinformowanie o szczeg\xf3\u0142ach technicznych, kt\xf3rych u\u017cytkownik mo\u017ce nie by\u0107 w stanie oceni\u0107 samodzielnie. Cho\u0107 pe\u0142na sytuacja zawsze jest bardziej skomplikowana, ocena bezpiecze\u0144stwa s\u0142u\u017cy uproszczeniu kluczowych kwestii zwi\u0105zanych z ryzykiem i bezpiecze\u0144stwem oraz umo\u017cliwia u\u017cytkownikowi rozpocz\u0119cie w\u0142asnej analizy due diligence. Nasz zesp\xf3\u0142 starannie rozwa\u017ca ka\u017cdy czynnik przed wdro\u017ceniem sejfu i uwa\u017cnie monitoruje ka\u017cdy zas\xf3b, \u0142a\u0144cuch i protok\xf3\u0142 zintegrowane przez {{providerName}}.",safetyScoreRateLink:"Wy\u015bwietl wi\u0119cej szczeg\xf3\u0142\xf3w na temat oceny bezpiecze\u0144stwa na stronie {{providerName}}"},viewMoreDetails:"Wy\u015bwietl wi\u0119cej szczeg\xf3\u0142\xf3w",viewLessDetails:"Wy\u015bwietl mniej szczeg\xf3\u0142\xf3w"},beforeDepositBottomSheet:{youNeedTitle:"Aby dokona\u0107 wp\u0142aty, potrzebny jest {{tokenSymbol}} w {{tokenNetwork}}",crossChainAlternativeDescription:"Je\u015bli nie chcesz u\u017cy\u0107 swoich token\xf3w w {{tokenNetwork}}, wybierz poni\u017csz\u0105 opcj\u0119. Trzeba b\u0119dzie tu wr\xf3ci\u0107, aby p\xf3\u017aniej sfinalizowa\u0107 wp\u0142at\u0119 do puli.",beforeYouCanDepositTitle:"Zanim b\u0119dzie mo\u017cna dokona\u0107 wp\u0142aty...",beforeYouCanDepositDescription:"Musisz doda\u0107 jeden z token\xf3w puli. Po dodaniu musisz tu wr\xf3ci\u0107, aby sfinalizowa\u0107 wp\u0142at\u0119 do puli.",action:{swapAndDeposit:"Wymiana i wp\u0142ata",swapAndDepositDescription:"Wybierz dowolny token w {{tokenNetwork}}. Wymienimy go i jednocze\u015bnie wp\u0142acimy za Ciebie.",crossChainSwap:"Wymiana mi\u0119dzy\u0142a\u0144cuchowa",crossChainSwapDescription:"Wymie\u0144 token z innej sieci na {{tokenSymbol}}",swap:"Zamieniaj",swapDescription:"Wymie\u0144 inny token w swoim portfelu na {{tokenSymbol}} w {{tokenNetwork}}",add:"Kup",addDescription:"Kup {{tokenSymbol}} w {{tokenNetwork}}, korzystaj\u0105c z us\u0142ug jednego z naszych zaufanych dostawc\xf3w",transfer:"Transfer",transferDescription:"U\u017cyj dowolnego portfela lub gie\u0142dy kompatybilnej z {{tokenNetwork}}, aby wp\u0142aci\u0107 {{tokenSymbol}}"}}},addFundsActions:{add:"Kup",transfer:"Transfer",swap:"Zamieniaj"},duration_lessThanADay:"Mniej ni\u017c jeden dzie\u0144",duration_day_one:"1 dzie\u0144",duration_day_other:"Liczba dni: {{count}}",duration_month_one:"1 miesi\u0105c",duration_month_other:"Liczba miesi\u0119cy: {{count}}",duration_year_one:"1 rok",duration_year_other:"Liczba lat: {{count}}",duration_yearMonth_one:"1 rok, 1 miesi\u0105c",duration_yearMonth_other:"Liczba lat: {{count}}, liczba miesi\u0119cy: {{count2}}",tokenEnterAmount:{availableBalance:"Dost\u0119pna: <0></0>",selectToken:"Wybierz token",fiatPriceUnavailable:"Cena niedost\u0119pna"},celoDollarAmount_0:"<0></0> Celo Dolar",celoDollarAmount_1:"&amp;lt;0&amp;gt;&amp;lt;/0&amp;gt; Celo Dolary",celoDollarAmount_2:"&amp;lt;0&amp;gt;&amp;lt;/0&amp;gt; Celo Dolar\xf3w",celoDollarAmount_3:"&amp;lt;0&amp;gt;&amp;lt;/0&amp;gt; Celo Dolara"}}),1327,[]);
