443\u043d\u043e\u043a \u0456 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u043d\u0430 \u0446\u0435\u0439 \u0435\u043a\u0440\u0430\u043d.",restart:"\u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0434\u043b\u044f \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043d\u044f"},revokePhoneNumber:{title:"\u0412\u0456\u0434\u0432\u2019\u044f\u0437\u0430\u0442\u0438 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443",bottomSheetTitle:"\u0412\u0456\u0434\u0432\u2019\u044f\u0437\u0430\u0442\u0438 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443",description:"\u042f\u043a\u0449\u043e \u0432\u0456\u0434\u0432\u2019\u044f\u0437\u0430\u0442\u0438 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443, \u043f\u0440\u0438\u0432\u2019\u044f\u0437\u0430\u043d\u0438\u0439 \u0434\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u0433\u0430\u043c\u0430\u043d\u0446\u044f, \u0439\u043e\u0433\u043e \u0431\u0443\u0434\u0435 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043e. \u041d\u043e\u0432\u0438\u0439 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u043c\u043e\u0436\u043d\u0430 \u0434\u043e\u0434\u0430\u0442\u0438 \u043f\u0456\u0437\u043d\u0456\u0448\u0435.",confirmButton:"\u0412\u0456\u0434\u0432\u2019\u044f\u0437\u0430\u0442\u0438 \u0437\u0430\u0440\u0430\u0437",revokeSuccess:"\u0412\u0430\u0448 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0432\u0456\u0434\u0432\u2019\u044f\u0437\u0430\u043d\u043e",revokeError:"\u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0432\u0456\u0434\u0432\u2019\u044f\u0437\u0430\u0442\u0438 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437 \u043f\u0456\u0437\u043d\u0456\u0448\u0435.",addNewNumberButton:"\u0414\u043e\u0434\u0430\u0442\u0438 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443"},promptFornoModal:{header:"\u041f\u0435\u0440\u0435\u043c\u043a\u043d\u0443\u0442\u0438 \u0440\u0435\u0436\u0438\u043c \u0437\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f?",body:"\u041c\u0438 \u043f\u043e\u043c\u0456\u0442\u0438\u043b\u0438, \u0449\u043e \u0443 \u0432\u0430\u0441 \u0432\u0438\u043d\u0438\u043a\u0430\u044e\u0442\u044c \u0434\u0435\u044f\u043a\u0456 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0437 \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f\u043c. \u041c\u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u043c\u043e \u0443\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0440\u0435\u0436\u0438\u043c \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445, \u0449\u043e\u0431 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044f {{appName}} \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u043e\u0433\u043e \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f.",switchToDataSaver:"\u041f\u0435\u0440\u0435\u043c\u043a\u043d\u0443\u0442\u0438 \u043d\u0430 \u0440\u0435\u0436\u0438\u043c \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445"},accountKeyModal:{header:"\u0411\u0435\u0437 \u0432\u0430\u0448\u043e\u0457 \u0444\u0440\u0430\u0437\u0438 \u0434\u043b\u044f \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0432\u0438 \u0432\u0442\u0440\u0430\u0442\u0438\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0441\u0432\u043e\u0457\u0445 \u043a\u043e\u0448\u0442\u0456\u0432 \u043d\u0430\u0437\u0430\u0432\u0436\u0434\u0438",body1:"\u0429\u043e\u0431 \u0441\u043a\u0438\u043d\u0443\u0442\u0438 {{appName}}, \u0432\u0430\u043c \u0442\u0440\u0435\u0431\u0430 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438, \u0449\u043e \u0432\u0438 \u0437\u0430\u043f\u0438\u0441\u0430\u043b\u0438 \u0444\u0440\u0430\u0437\u0443 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f.",body2:"\u041d\u0456\u0445\u0442\u043e, \u043d\u0430\u0432\u0456\u0442\u044c {{appName}}, \u043d\u0435 \u043c\u043e\u0436\u0435 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0432\u0430\u0448 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0431\u0435\u0437 \u0444\u0440\u0430\u0437\u0438 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f."},promptConfirmRemovalModal:{header:"\u0423\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0449\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438?",body:"\u0412\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u0442\u0435\u0441\u044f \u0441\u0442\u0435\u0440\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457. \u0426\u0435\u0439 \u043a\u0440\u043e\u043a \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0438\u0439 \u0456 \u043d\u0435 \u043f\u0456\u0434\u043b\u044f\u0433\u0430\u0454 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u043d\u043d\u044e. \u041d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0444\u0440\u0430\u0437\u0443 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u0449\u043e \u0432\u0438 \u043d\u0435 \u0437\u0430\u043f\u0438\u0441\u0430\u043b\u0438 \u0457\u0457.",resetNow:"\u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438"},protectWallet:{title:"\u0417\u0430\u0445\u0438\u0441\u0442\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",subtitle:"\u0417\u0430\u0445\u0438\u0441\u0442\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",body:"\u042f\u043a\u0449\u043e \u0432\u0438 \u0437\u0430\u0433\u0443\u0431\u0438\u043b\u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0430\u0431\u043e \u0439\u043e\u0433\u043e \u0432\u043a\u0440\u0430\u043b\u0438, \u0432\u0430\u0448\u0430 \u0444\u0440\u0430\u0437\u0430 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0437 12 \u0441\u043b\u0456\u0432 \u2015 \u0437\u0430\u043f\u043e\u0440\u0443\u043a\u0430 \u0442\u043e\u0433\u043e, \u0449\u043e \u0432\u0438 \u0437\u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0441\u0432\u043e\u0457\u0445 \u043a\u043e\u0448\u0442\u0456\u0432.",recoveryPhrase:{title:"\u0421\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044f \u0444\u0440\u0430\u0437\u043e\u044e \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",subtitle:"\u0412\u0438\u043f\u0438\u0448\u0456\u0442\u044c \u0441\u0432\u043e\u044e \u0444\u0440\u0430\u0437\u0443 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f"}},recoveryPhrase:{title:"\u0412\u0430\u0448\u0430 \u0444\u0440\u0430\u0437\u0430 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",titleV1_90:"\u0412\u0430\u0448\u0430 \u0444\u0440\u0430\u0437\u0430 \u0434\u043b\u044f \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",body:"\u0412\u0438\u043f\u0438\u0448\u0456\u0442\u044c \u0446\u0456 12 \u0441\u043b\u0456\u0432 \u0456 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0439\u0442\u0435 \u0432 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456, \u0443 \u044f\u043a\u043e\u043c\u0443 \u0457\u0445 \u043d\u0435 \u0437\u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u043a\u0440\u0430\u0441\u0442\u0438 \u0447\u0438 \u043f\u043e\u0448\u043a\u043e\u0434\u0438\u0442\u0438.",bodyV1_90:"\u042f\u043a\u0449\u043e \u0432\u0438 \u0437\u0430\u0433\u0443\u0431\u0438\u0442\u0435 \u0444\u0440\u0430\u0437\u0443 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u0442\u043e \u0432\u0442\u0440\u0430\u0442\u0438\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0432\u0441\u0456\u0445 \u043a\u043e\u0448\u0442\u0456\u0432 \u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443 {{appName}}.",continue:"\u0424\u0440\u0430\u0437\u0443 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e",copy:"\u041a\u043e\u043f\u0456\u044e\u0432\u0430\u0442\u0438 \u0434\u043e \u0431\u0443\u0444\u0435\u0440\u0430 \u043e\u0431\u043c\u0456\u043d\u0443",mnemonicCopied:"\u0424\u0440\u0430\u0437\u0443 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0441\u043a\u043e\u043f\u0456\u0439\u043e\u0432\u0430\u043d\u043e \u0434\u043e \u0431\u0443\u0444\u0435\u0440\u0430 \u043e\u0431\u043c\u0456\u043d\u0443",bottomSheet:{title:"\u042f\u043a \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0444\u0440\u0430\u0437\u0443 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",writeDownPhrase:"\u0412\u0438\u043f\u0438\u0448\u0456\u0442\u044c \u0441\u0432\u043e\u044e \u0444\u0440\u0430\u0437\u0443 \u0434\u043b\u044f \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0456 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0439\u0442\u0435 \u0457\u0457 \u0432 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456. \u0422\u0430\u043a \u0432\u0438 \u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0454\u0442\u0435\u0441\u044f \u043e\u0434\u043d\u0438\u043c \u0456\u0437 \u043d\u0430\u0439\u043d\u0430\u0434\u0456\u0439\u043d\u0456\u0448\u0438\u0445 \u0441\u043f\u043e\u0441\u043e\u0431\u0456\u0432 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438 \u0441\u0432\u0456\u0439 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c.",phraseLocation:"\u0414\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u0456\u0434\u0456\u0439\u0434\u0435 \u043c\u0456\u0441\u0446\u0435, \u0443 \u044f\u043a\u043e\u043c\u0443 \u0432\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u0435 \u0456\u043d\u0448\u0456 \u0432\u0430\u0436\u043b\u0438\u0432\u0456 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438 \u0439 \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u0438 \u0432 \u0446\u0456\u043b\u044f\u0445 \u0431\u0435\u0437\u043f\u0435\u043a\u0438, \u043d\u0430\u0434\u0456\u0439\u043d\u043e \u0437\u0430\u0445\u0438\u0449\u0435\u043d\u0456 \u0432\u0456\u0434 \u043a\u0440\u0430\u0434\u0456\u0436\u043a\u0438 \u0439 \u043f\u0440\u0438\u0432\u043b\u0430\u0441\u043d\u0435\u043d\u043d\u044f. \u0412\u0438\u0431\u0438\u0440\u0430\u0442\u0438 \u0432\u0430\u043c!"}},walletSecurityPrimer:{title:"\u0422\u0440\u0438\u043c\u0430\u0439\u0442\u0435 \u0441\u0432\u0456\u0439 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c \u0443 \u0431\u0435\u0437\u043f\u0435\u0446\u0456",description:"\u0422\u0456\u043b\u044c\u043a\u0438 \u0432\u0438 \u043c\u0430\u0454\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0441\u0432\u043e\u0433\u043e \u0433\u0430\u043c\u0430\u043d\u0446\u044f. \u042f\u043a\u0449\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0432\u0442\u0440\u0430\u0447\u0435\u043d\u043e \u0430\u0431\u043e \u0432\u0438\u043a\u0440\u0430\u0434\u0435\u043d\u043e, \u0434\u043e\u0441\u0442\u0443\u043f \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e {{appName}}.\n\n\u0412\u0430\u043c \u0442\u0440\u0435\u0431\u0430 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u043c\u0435\u0442\u043e\u0434\u0438 \u0434\u043b\u044f \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438 \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u0432\u0430\u0448\u043e\u0433\u043e \u0433\u0430\u043c\u0430\u043d\u0446\u044f \u0442\u0430 \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0432\u0430\u0448\u0438\u0445 \u043a\u043e\u0448\u0442\u0456\u0432."},keylessBackupIntro:{emailAddress:"\u0410\u0434\u0440\u0435\u0441\u0430 \u0435\u043b. \u043f\u043e\u0448\u0442\u0438",phoneNumber:"\u041d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443",setup:{title:"\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0435 \u043a\u043e\u043f\u0456\u044e\u0432\u0430\u043d\u043d\u044f \u0433\u0430\u043c\u0430\u043d\u0446\u044f",description:"\u0429\u043e\u0431 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0435 \u043a\u043e\u043f\u0456\u044e\u0432\u0430\u043d\u043d\u044f \u0437\u0430 \u0430\u0434\u0440\u0435\u0441\u043e\u044e \u0435\u043b. \u043f\u043e\u0448\u0442\u0438 \u0439 \u043d\u043e\u043c\u0435\u0440\u043e\u043c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443, \u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435\u0441\u044f \u0442\u0430\u043a\u0438\u043c\u0438 \u0434\u0430\u043d\u0438\u043c\u0438",useRecoveryPhrase:"\u041d\u0430\u0442\u043e\u043c\u0456\u0441\u0442\u044c \u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435\u0441\u044f \u0444\u0440\u0430\u0437\u043e\u044e \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",reminder:"<0>\u041d\u0430\u0433\u0430\u0434\u0443\u0454\u043c\u043e</0>, \u0449\u043e \u0446\u044f \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f \u0454 \u0454\u0434\u0438\u043d\u0438\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u0433\u0430\u043c\u0430\u043d\u0446\u044f, \u044f\u043a\u0449\u043e \u0432\u0430\u0448 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0431\u0443\u0434\u0435 \u0432\u0442\u0440\u0430\u0447\u0435\u043d\u043e \u0430\u0431\u043e \u0432\u043a\u0440\u0430\u0434\u0435\u043d\u043e. {{appName}} \u043d\u0435 \u0437\u