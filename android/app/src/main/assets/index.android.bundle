35 \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u0432 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0431\u0430\u043b\u043b\u044b \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f. \u0421\u043b\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438."},activitySection:{title:"\u041a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u0431\u0430\u043b\u043b\u044b?",body:"\u0412\u0441\u0435 \u043f\u0440\u043e\u0441\u0442\u043e! \u0417\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0439\u0442\u0435 \u0431\u0430\u043b\u043b\u044b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435."},noActivities:{title:"\u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0431\u0430\u043b\u043b\u043e\u0432 \ud83d\udd13",body:"\u041e\u0439! \u041a\u0430\u0436\u0435\u0442\u0441\u044f, \u0432\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0435 \u0431\u043e\u043b\u0435\u0435 \u0441\u0442\u0430\u0440\u0443\u044e \u0432\u0435\u0440\u0441\u0438\u044e {{appName}}. \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u0441\u0435\u0439\u0447\u0430\u0441, \u0447\u0442\u043e\u0431\u044b \u0443\u0437\u043d\u0430\u0442\u044c \u0432\u0441\u0435 \u043d\u043e\u0432\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0431\u0430\u043b\u043b\u043e\u0432."},activityCards:{createWallet:{title:"\u0421\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u043a\u043e\u0448\u0435\u043b\u0435\u043a {{appName}}"},swap:{title:"\u041e\u0431\u043c\u0435\u043d\u044f\u0442\u044c \u0430\u043a\u0442\u0438\u0432\u044b",bottomSheet:{title:"\u041e\u0431\u043c\u0435\u043d\u044f\u0442\u044c \u0430\u043a\u0442\u0438\u0432\u044b",body:"\u0417\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0439\u0442\u0435 \u043f\u043e {{pointsValue}} \u0431\u0430\u043b\u043b\u043e\u0432 \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043e\u0431\u043c\u0435\u043d \u0430\u043a\u0442\u0438\u0432\u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e {{appName}}. \n\n\u041d\u0430\u0436\u043c\u0438 \u043d\u0438\u0436\u0435, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u043e\u0431\u043c\u0435\u043d\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0438 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c!",cta:"\u041d\u0430\u0447\u0430\u0442\u044c \u043e\u0431\u043c\u0435\u043d"}},moreComing:{title:"\u0421\u043a\u043e\u0440\u043e \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f \u043d\u043e\u0432\u044b\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438!"},createLiveLink:{title:"\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u043e \u043f\u0440\u044f\u043c\u043e\u0439 \u0441\u0441\u044b\u043b\u043a\u0435",bottomSheet:{title:"\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u043e \u043f\u0440\u044f\u043c\u043e\u0439 \u0441\u0441\u044b\u043b\u043a\u0435",body:"\u0417\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0439\u0442\u0435 {{pointsValue}} \u0431\u0430\u043b\u043b\u043e\u0432 \u0437\u0430 \u043a\u0430\u0436\u0434\u0443\u044e \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0443 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e Live Link \u0432 {{appName}}. \n\n\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0438\u0436\u0435, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0438 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c!",cta:"\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u043e \u043f\u0440\u044f\u043c\u043e\u0439 \u0441\u0441\u044b\u043b\u043a\u0435"}},depositEarn:{title:"\u0412\u043d\u0435\u0441\u0438\u0442\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0432 \u0434\u043e\u0445\u043e\u0434\u043d\u044b\u0439 \u043f\u0443\u043b \u0432 {{appName}}",bottomSheet:{title:"\u0412\u043d\u0435\u0441\u0438\u0442\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0432 \u0434\u043e\u0445\u043e\u0434\u043d\u044b\u0439 \u043f\u0443\u043b",body:"\u0417\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0439\u0442\u0435 {{pointsValue}} \u0431\u0430\u043b\u043b\u043e\u0432 \u0437\u0430 \u043a\u0430\u0436\u0434\u043e\u0435 \u0432\u043d\u0435\u0441\u0435\u043d\u0438\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0432 \u0434\u043e\u0445\u043e\u0434\u043d\u044b\u0439 \u043f\u0443\u043b \u0432 {{appName}}. \n\n\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0438\u0436\u0435, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0434\u043e\u0445\u043e\u0434 \u0438 \u0431\u0430\u043b\u043b\u044b!",cta:"\u041f\u0440\u0435\u0439\u0442\u0438 \u043a \u0434\u043e\u0445\u043e\u0434\u043d\u044b\u043c \u043f\u0443\u043b\u0430\u043c"}}},discoverCard:{title:"\u0411\u0430\u043b\u043b\u044b {{appName}}",description:"\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0431\u0430\u043b\u043b\u044b \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e {{appName}}. \u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043e\u0431\u043c\u0435\u043d!",balance:"\u0431\u0430\u043b\u043b\u044b {{pointsBalance}}"},intro:{title:"\u041f\u0440\u043e\u0441\u0442\u043e\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0431\u0430\u043b\u043b\u043e\u0432",description:"\u041f\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u043d\u0430 \u043d\u043e\u0432\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043a\u0430! \u0417\u0430 \u0432\u0430\u0448\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0432 {{appName}} \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0430\u0447\u0438\u0441\u043b\u044f\u044e\u0442\u0441\u044f \u0431\u0430\u043b\u043b\u044b. \u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0438 \u043e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0434\u043b\u044f \u0441\u0435\u0431\u044f \u043f\u043e\u0442\u0440\u044f\u0441\u0430\u044e\u0449\u0438\u0435 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430.",cta:"\u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0431\u0430\u043b\u043b\u044b"},disclaimer:{learnMoreCta:"<0>\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435</0> \u043e \u0431\u0430\u043b\u043b\u0430\u0445 {{appName}}",title:"\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u0435\u0435 \u043e \u0431\u0430\u043b\u043b\u0430\u0445 {{appName}}",body:"\u0411\u0430\u043b\u043b\u044b \u2014 \u044d\u0442\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430 \u043b\u043e\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0438 {{appName}}. \u041e\u043d\u0438 \u043d\u0430\u0447\u0438\u0441\u043b\u044f\u044e\u0442\u0441\u044f \u0437\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f. \u0411\u0430\u043b\u043b\u044b \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u0442\u044c, \u043e\u0431\u043c\u0435\u043d\u044f\u0442\u044c \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u044c.",dismiss:"\u041f\u043e\u043d\u044f\u0442\u043d\u043e"}},earnFlow:{gasSubsidized:"\u041a\u043e\u043c\u0438\u0441\u0441\u0438\u0438 \u0437\u0430 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438 \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438",addCryptoBottomSheet:{title:"\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 {{tokenSymbol}} \u0432 {{tokenNetwork}}",description:"\u041a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u044b \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u0435 \u0442\u043e\u043a\u0435\u043d\u044b, \u0432\u0430\u043c \u043f\u0440\u0438\u0434\u0435\u0442\u0441\u044f \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f \u0434\u0435\u043f\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u043f\u0443\u043b.",actions:{add:"\u041a\u0443\u043f\u0438\u0442\u044c",transfer:"\u041f\u0435\u0440\u0435\u0432\u043e\u0434",swap:"\u041e\u0431\u043c\u0435\u043d"},actionDescriptions:{add:"\u041a\u0443\u043f\u0438\u0442\u0435 {{tokenSymbol}} \u0432 {{tokenNetwork}} \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u0434\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0445 \u043f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a\u043e\u0432",transfer:"\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u044b\u0439 \u0441 {{tokenNetwork}} \u043a\u043e\u0448\u0435\u043b\u0435\u043a \u0438\u043b\u0438 \u043a\u0440\u0438\u043f\u0442\u043e\u0431\u0438\u0440\u0436\u0443 \u0434\u043b\u044f \u0434\u0435\u043f\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f {{tokenSymbol}}",swap:"\u041e\u0431\u043c\u0435\u043d\u044f\u0442\u044c \u043d\u0430 {{tokenSymbol}} \u0441 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u0442\u043e\u043a\u0435\u043d\u043