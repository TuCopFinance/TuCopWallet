6\u0435\u0439 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u043d\u0435 \u043f\u0435\u0440\u0435\u043b\u0456\u0447\u0435\u043d\u0438\u0439 \u0443 {{appName}}. \u0426\u0456 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0438 \u0454 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456\u043c\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0430\u043c\u0438. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0457\u0445 \u043d\u0430 \u0441\u0432\u0456\u0439 \u0441\u0442\u0440\u0430\u0445 \u0456 \u0440\u0438\u0437\u0438\u043a.",swapScreen:{title:"\u041e\u0431\u043c\u0456\u043d\u044f\u0442\u0438",review:"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u0434",confirmSwap:"\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0441\u0432\u043e\u043f",confirmSwap_UK:"\u0425\u043e\u0447\u0443 \u043e\u0431\u043c\u0456\u043d\u044f\u0442\u0438",swapFrom:"\u0417",swapTo:"\u041d\u0410",insufficientFunds:"{{token}}: \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043d\u0456\u0439 \u0431\u0430\u043b\u0430\u043d\u0441. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043c\u0435\u043d\u0448\u0443 \u0441\u0443\u043c\u0443 \u0430\u0431\u043e \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0456\u043d\u0448\u0438\u0439 \u0430\u043a\u0442\u0438\u0432.",fetchSwapQuoteFailed:"\u0412\u0438\u0431\u0430\u0447\u0442\u0435 \u0437\u0430 \u0437\u0430\u0442\u0440\u0438\u043c\u043a\u0443! \u0426\u0435 \u0437\u0430\u0431\u0438\u0440\u0430\u0454 \u0431\u0456\u043b\u044c\u0448\u0435 \u0447\u0430\u0441\u0443, \u043d\u0456\u0436 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439, \u0449\u043e\u0431 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u043e\u0431\u043c\u0456\u043d\u043d\u0438\u0439 \u043a\u0443\u0440\u0441. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u043d\u043e\u0432\u0443 \u0437\u0430 \u043a\u0456\u043b\u044c\u043a\u0430 \u0445\u0432\u0438\u043b\u0438\u043d.",disclaimer:"\u041d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u043a\u0443\u0440\u0441, \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439 \u0434\u0435\u0446\u0435\u043d\u0442\u0440\u0430\u043b\u0456\u0437\u043e\u0432\u0430\u043d\u0438\u043c\u0438 \u0434\u0436\u0435\u0440\u0435\u043b\u0430\u043c\u0438. <0>\u0414\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f \u0431\u0456\u043b\u044c\u0448\u0435</0>",disclaimer_UK:"\u0426\u0435 \u043d\u0435 \u0454 \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u044f\u043c \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0442\u0438 \u0430\u0431\u043e \u043a\u0443\u043f\u0443\u0432\u0430\u0442\u0438 \u043a\u0440\u0438\u043f\u0442\u043e\u0430\u043a\u0442\u0438\u0432\u0438. \u041d\u0430\u0442\u0438\u0441\u043a\u0430\u044e\u0447\u0438 \u043a\u043d\u043e\u043f\u043a\u0443 \xab\u0425\u043e\u0447\u0443 \u043e\u0431\u043c\u0456\u043d\u044f\u0442\u0438\xbb, \u0432\u0438 \u0434\u043e\u0440\u0443\u0447\u0430\u0454\u0442\u0435 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044c\u043e\u043c\u0443 \u0441\u0432\u043e\u043f-\u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438 \u0432\u0430\u0448\u0443 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e \u043e\u0431\u043c\u0456\u043d\u0443 \u0437\u0430 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u043c \u043a\u0443\u0440\u0441\u043e\u043c. \u041d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u043a\u0443\u0440\u0441 \u043d\u0430\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430\u043c\u0438 \u043c\u0435\u0440\u0435\u0436\u0456. <0>\u0414\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f \u0431\u0456\u043b\u044c\u0448\u0435</0>",swapFromTokenSelection:"\u0421\u0412\u041e\u041f \u0406\u0417",swapToTokenSelection:"\u04