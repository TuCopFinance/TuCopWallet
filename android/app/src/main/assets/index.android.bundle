e1c d\u1ecbch v\u1ee5 h\u1ecd cung c\u1ea5p. V\xed d\u1ee5 v\u1ec1 c\xe1c d\u1ecbch v\u1ee5 n\xe0y bao g\u1ed3m trao \u0111\u1ed5i phi t\u1eadp trung, cho vay, vay, ho\xe1n \u0111\u1ed5i, l\u01b0u tr\u1eef NFT.",buttonLabel:"N\xf3i cho t\xf4i bi\u1ebft th\xeam"},dappsDisclaimerAllDapps:"{{AppName}} kh\xf4ng li\xean k\u1ebft v\u1edbi c\xe1c Dapp n\xe0y v\xe0 kh\xf4ng \u0111\u01b0a ra c\xe1c \u0111\u1ea1i di\u1ec7n ho\u1eb7c khi\u1ebfu n\u1ea1i n\xe0o trong vi\u1ec7c s\u1eed d\u1ee5ng ch\xfang. Vui l\xf2ng x\xe1c nh\u1eadn r\u1ee7i ro tr\u01b0\u1edbc khi s\u1eed d\u1ee5ng Dapp b\u1eb1ng c\xe1ch xem x\xe9t Th\u1ecfa thu\u1eadn ng\u01b0\u1eddi d\xf9ng ho\u1eb7c Ch\xednh s\xe1ch b\u1ea3o m\u1eadt.",dappsDisclaimerSingleDapp:"{{appName}} kh\xf4ng li\xean k\u1ebft v\u1edbi Dapp n\xe0y v\xe0 kh\xf4ng c\xf3 bi\u1ec3u di\u1ec5n n\xe0o trong vi\u1ec7c s\u1eed d\u1ee5ng n\xf3. Lu\xf4n xem x\xe9t th\u1ecfa thu\u1eadn ng\u01b0\u1eddi d\xf9ng ho\u1eb7c ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 c\u1ee7a Dapp.",dappsDisclaimerUnlistedDapp:"Dapp n\xe0y kh\xf4ng \u0111\u01b0\u1ee3c li\u1ec7t k\xea trong {{appName}}. {{appName}} kh\xf4ng li\xean k\u1ebft v\u1edbi Dapp n\xe0y v\xe0 kh\xf4ng c\xf3 bi\u1ec3u di\u1ec5n n\xe0o trong vi\u1ec7c s\u1eed d\u1ee5ng n\xf3. Lu\xf4n xem x\xe9t th\u1ecfa thu\u1eadn ng\u01b0\u1eddi d\xf9ng ho\u1eb7c ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 c\u1ee7a Dapp.",recentlyUsedDapps:"C\xe1c Dapp \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng g\u1ea7n \u0111\xe2y",favoritedDapps:"DApps \u0111\u01b0\u1ee3c y\xeau th\xedch",allDapps:"T\u1ea5t c\u1ea3 c\xe1c Dapp",rewards:"Ti\u1ec1n th\u01b0\u1edfng",supercharge:"Supercharge",others:"Kh\xe1c",nomSpaceRecipient:"Nomspace: {{name}}",lastDay:"24 gi\u1edd qua",noMoreTransactions:"Kh\xf4ng c\xf2n giao d\u1ecbch kh\xe1c",selectProviderScreen:{somePaymentsUnavailable:"Giao d\u1ecbch mua h\xe0ng \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 b\u1edfi c\xe1c nh\xe0 cung c\u1ea5p \u0111\u1ed1i t\xe1c c\u1ee7a ch\xfang t\xf4i. L\u1ec7 p