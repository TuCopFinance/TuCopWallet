ming:{title:"\u041d\u0435\u0437\u0430\u0431\u0430\u0440\u043e\u043c \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0435\u0439 \u0441\u0442\u0430\u043d\u0435 \u0431\u0456\u043b\u044c\u0448\u0435!"},createLiveLink:{title:"\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0437\u0430 \u043f\u0440\u044f\u043c\u0438\u043c \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f\u043c",bottomSheet:{title:"\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0437\u0430 \u043f\u0440\u044f\u043c\u0438\u043c \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f\u043c",body:"\u0417\u0430\u0440\u043e\u0431\u043b\u044f\u0439\u0442\u0435 {{pointsValue}} \u0431\u0430\u043b\u0456\u0432 \u0449\u043e\u0440\u0430\u0437\u0443, \u043a\u043e\u043b\u0438 \u0432\u0438 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0454\u0442\u0435 \u043a\u043e\u0448\u0442\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Live Link \u0443 {{appName}}.\n\n\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u0442\u0430 \u0437\u0430\u0440\u043e\u0431\u043b\u044f\u0442\u0438!",cta:"\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0437\u0430 \u043f\u0440\u044f\u043c\u0438\u043c \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f\u043c"}},depositEarn:{title:"\u0412\u043d\u0435\u0441\u0456\u0442\u044c \u043a\u043e\u0448\u0442\u0438 \u0432 \u043f\u0443\u043b \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443 \u0432 {{appName}}",bottomSheet:{title:"\u0412\u043d\u0435\u0441\u0456\u0442\u044c \u043a\u043e\u0448\u0442\u0438 \u0432 \u043f\u0443\u043b \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443",body:"\u0417\u0430\u0440\u043e\u0431\u043b\u044f\u0439\u0442\u0435 {{pointsValue}} \u0431\u0430\u043b\u0456\u0432 \u0449\u043e\u0440\u0430\u0437\u0443, \u043a\u043e\u043b\u0438 \u0432\u0438 \u0432\u043d\u043e\u0441\u0438\u0442\u0435 \u043a\u043e\u0448\u0442\u0438 \u0432 \u043f\u0443\u043b \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443 \u0432 {{appName}}. \n\n\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043d\u0438\u0436\u0447\u0435, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438 \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u0438 \u0442\u0430 \u0431\u0430\u043b\u0438!",cta:"\u041f\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044c \u0434\u043e \u043f\u0443\u043b\u0456\u0432 \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443"}}},discoverCard:{title:"\u0411\u0430\u043b\u0438 {{appName}}",description:"\u0417 {{appName}} \u0437\u0430\u0440\u043e\u0431\u043b\u044f\u0442\u0438 \u0431\u0430\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e. \u041e\u0442\u0440\u0438\u043c\u0443\u0439\u0442\u0435 \u0431\u0430\u043b\u0438 \u0437\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u043e\u043c, \u0437\u043e\u043a\u0440\u0435\u043c\u0430 \u0437\u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0457 \u043e\u0431\u043c\u0456\u043d\u0443!",balance:"\u0431\u0430\u043b\u0438 {{pointsBalance}}"},intro:{title:"\u0417\u0430\u0440\u043e\u0431\u043b\u044f\u0439\u0442\u0435 \u0431\u0430\u043b\u0438 \u0431\u0435\u0437 \u0437\u0430\u0439\u0432\u0438\u0445 \u0437\u0443\u0441\u0438\u043b\u044c",description:"\u041f\u0435\u0440\u0435\u0445\u043e\u0434\u044c\u0442\u0435 \u0434\u043e \u043d\u043e\u0432\u043e\u0433\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u0443 \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443! \u0422\u0435\u043f\u0435\u0440 \u0437\u0430\u0440\u043e\u0431\u043b\u044f\u0439\u0442\u0435 \u0431\u0430\u043b\u0438 \u0437\u0430 \u0441\u0432\u043e\u044e \u0430\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0443 {{appName}}. \u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0437\u0430\u0440\u043e\u0431\u043b\u044f\u0442\u0438 \u0432\u0436\u0435 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u0442\u0430 \u0432\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u043d\u0435\u0447\u0443\u0432\u0430\u043d\u0456 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0438.",cta:"\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u0442\u044c \u0433\u043e\u043d\u0438\u0442\u0432\u0443 \u0437\u0430 \u0431\u0430\u043b\u0430\u043c\u0438"},disclaimer:{learnMoreCta:"<0>\u0414\u0456\u0437\u043d\u0430\u0439\u0442\u0435\u0441\u044f \u0431\u0456\u043b\u044c\u0448\u0435</0> \u043f\u0440\u043e \u0431\u0430\u043b\u0438 {{appName}}",title:"\u0414\u043e\u043a\u043b\u0430\u0434\u043d\u0456\u0448\u0435 \u043f\u0440\u043e \u0431\u0430\u043b\u0438 {{appName}}",body:"\u0411\u0430\u043b\u0438 \u2014 \u0446\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430 \u043b\u043e\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456 {{appName}}. \u0412\u043e\u043d\u0438 \u043d\u0430\u0440\u0430\u0445\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430\u043c \u0437\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443. \u0411\u0430\u043b\u0438 \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u0442\u0440\u0430\u0442\u0438\u0442\u0438, \u043e\u0431\u043c\u0456\u043d\u044f\u0442\u0438 \u0430\u0431\u043e \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u0438.",dismiss:"\u0417\u0440\u043e\u0437\u0443\u043c\u0456\u043b\u043e"}},earnFlow:{gasSubsidized:"\u041a\u043e\u043c\u0456\u0441\u0456\u0457 \u0437\u0430 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u0457 \u043f\u043e\u043a\u0440\u0438\u0432\u0430\u044e\u0442\u044c\u0441\u044f \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0456\u043e\u0434\u0443",addCryptoBottomSheet:{title:"\u0414\u043e\u0434\u0430\u0442\u0438 {{tokenSymbol}} \u0443 \u043c\u0435\u0440\u0435\u0436\u0456 {{tokenNetwork}}",description:"\u041a\u043e\u043b\u0438 \u0442\u043e\u043a\u0435\u043d\u0438 \u0434\u043e\u0434\u0430\u043d\u043e, \u0432\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u0456 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u043f\u043e\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u043f\u0443\u043b\u0443.",actions:{add:"\u041a\u0443\u043f\u0438\u0442\u0438",transfer:"\u041f\u0435\u0440\u0435\u043a\u0430\u0437\u0430\u0442\u0438",swap:"\u041e\u0431\u043c\u0456\u043d\u044f\u0442\u0438"},actionDescriptions:{add:"\u041a\u0443\u043f\u0456\u0442\u044c {{tokenSymbol}} \u0443 \u043c\u0435\u0440\u0435\u0436\u0456 {{tokenNetwork}} \u0447\u0435\u0440\u0435\u0437 \u043e\u0434\u043d\u043e\u0433\u043e \u0437 \u043d\u0430\u0448\u0438\u0445 \u0434\u043e\u0432\u0456\u0440\u0435\u043d\u0438\u0445 \u043f\u043e\u0441\u0442\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a\u0456\u0432",transfer:"\u0421\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435\u0441\u044f \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u043c \u0433\u0430\u043c\u0430\u043d\u0446\u0435\u043c, \u0441\u0443\u043c\u0456\u0441\u043d\u0438\u043c \u0456\u0437 \u043c\u0435\u0440\u0435\u0436\u0435\u044e {{tokenNetwork}} \u0430\u0431\u043e \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u043e\u0431\u043c\u0456\u043d, \u0449\u043e\u0431 \u0432\u043d\u0435\u0441\u0442\u0438 {{tokenSymbol}}",swap:"\u041e\u0431\u043c\u0456\u043d\u044f\u0442\u0438 \u043d\u0430 {{tokenSymbol}} \u0437 \u0456\u043d\u0448\u043e\u0433\u043e \u0442\u043e\u043a\u0435\u043d\u0430 {{tokenNetwork}}"}},cta:{title:"\u0417\u0430\u0440\u043e\u0431\u043b\u044f\u0439\u0442\u0435 \u043d\u0430 \u0441\u0432\u043e\u0457\u0439 \u043a\u0440\u0438\u043f\u0442\u043e\u0432\u0430\u043b\u044e\u0442\u0456",subtitle:"\u0412\u043d\u0435\u0441\u0456\u0442\u044c \u043a\u043e\u0448\u0442\u0438 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u0439 