 c\u1eadp v\xe0o m\u1ecdi t\xe0i s\u1ea3n c\u1ee7a m\xecnh tr\xean {{appName}}. Kh\xf4ng ai k\u1ec3 c\u1ea3 {{appName}} c\xf3 th\u1ec3 gi\xfap b\u1ea1n kh\xf4i ph\u1ee5c t\xe0i kho\u1ea3n m\xe0 kh\xf4ng c\xf3 C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c. H\xe3y l\u01b0u gi\u1eef c\u1ee5m t\u1eeb n\xe0y \u1edf n\u01a1i an to\xe0n v\xe0 kh\xf4ng chia s\u1ebb v\u1edbi ng\u01b0\u1eddi kh\xe1c.",postSetupCTA:"T\xecm hi\u1ec3u v\u1ec1 C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c",failedFetchMnemonic:"Kh\xf4ng t\xecm n\u1ea1p \u0111\u01b0\u1ee3c C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n",backupAndRecovery:"Sao l\u01b0u v\xe0 kh\xf4i ph\u1ee5c",writeDownKey:"Vui l\xf2ng vi\u1ebft ra C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n",writeDownKeyExperimental:"Vui l\xf2ng vi\u1ebft ra c\u1ee5m t\u1eeb c\u1ee7a b\u1ea1n.",completeEducation:"T\xf4i \u0111\xe3 hi\u1ec3u",yourAccountKey:"C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n",backupKeyNotification2:"\u0110\u1ec3 b\u1ea3o v\u1ec7 ti\u1ec1n c\u1ee7a b\u1ea1n, h\xe3y sao l\u01b0u C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c ngay.",keylessBackupCTA:"Sao l\u01b0u ngay",keylessBackupNotification:"Thi\u1ebft l\u1eadp email v\xe0 s\u1ed1 \u0111i\u1ec7n tho\u1ea1i \u0111\u1ec3 sao l\u01b0u c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c",backupKeyCTA:"Ho\xe0n t\u1ea5t quy tr\xecnh sao l\u01b0u ngay",backupKeySummary:"T\xecm m\u1ed9t n\u01a1i ri\xeang t\u01b0 v\xe0 vi\u1ebft ra C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n. Vui l\xf2ng l\u01b0u gi\u1eef C\u1ee5m t\u1eeb n\xe0y \u1edf n\u01a1i an to\xe0n. Kh\xf4ng l\u01b0u v\xe0o \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n.",backupKeyWarning:"N\u1ebfu l\xe0m m\u1ea5t c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c, b\u1ea1n s\u1ebd m\u1ea5t truy\u1ec1n truy c\u1eadp v\xe0o to\xe0n b\u1ed9 s\u1ed1 ti\u1ec1n b\u1ea1n n\u1eafm gi\u1eef tr\xean {{appName}}.",copied:"\u0110\xe3 sao ch\xe9p C\u1ee5m t\u1eeb v\xe0o b\u1ea3ng nh\u1edb t\u1ea1m",moreInfo:"Th\xeam th\xf4ng tin",savedConfirmation:"C\xf3, t\xf4i \u0111\xe3 vi\u1ebft ra C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a m\xecnh.",backupQuizWordCount:"T\u1eeb <0>{{ordinal}}</0> trong C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n l\xe0 g\xec?",backupQuizWordCountV1_83:"T\u1eeb <0>{{wordNumber}}</0> trong C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n l\xe0 g\xec?",importBackupFailed:"Kh\xf4ng nh\u1eadp \u0111\u01b0\u1ee3c v\xed",backupQuizFailed:"C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c b\u1ea1n nh\u1eadp kh\xf4ng ch\xednh x\xe1c. Vui l\xf2ng th\u1eed l\u1ea1i.",invalidBackupPhrase:"C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c kh\xf4ng h\u1ee3p l\u1ec7",invalidWordsInBackupPhrase:"M\u1ed9t s\u1ed1 t\u1eeb trong C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c kh\xf4ng h\u1ee3p l\u1ec7: {{ invalidWords }}",backupComplete:{header:"\u0110\xe3 sao l\u01b0u xong",0:"Th\xe0nh c\xf4ng!",1:"Ti\u1ebfp theo, b\u1ea1n c\xf3 th\u1ec3 thi\u1ebft l\u1eadp Bi\u1ec7n ph\xe1p b\u1ea3o v\u1ec7.",2:"B\u1ea1n \u0111\xe3 ho\xe0n t\u1ea5t!"},cancelDialog:{title:"Ho\xe0n t\u1ea5t qu\xe1 tr\xecnh thi\u1ebft l\u1eadp C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c",body:"C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\xf3 \xfd ngh\u0129a v\xf4 c\xf9ng quan tr\u1ecdng. N\u1ebfu kh\xf4ng c\xf3 C\u1ee5m t\u1eeb n\xe0y, b\u1ea1n c\xf3 th\u1ec3 m\u1ea5t v\u0129nh vi\u1ec5n quy\u1ec1n truy c\u1eadp v\xe0o v\xed c\u1ee7a m\xecnh.\nB\u1ea1n s\u1ebd kh\xf4ng g\u1eedi \u0111\u01b0\u1ee3c b\u1ea5t k\u1ef3 giao d\u1ecbch n\xe0o cho \u0111\u1ebfn khi thi\u1ebft l\u1eadp xong C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c.",action:"Ho\xe0n t\u1ea5t ngay",secondary:"Thi\u1ebft l\u1eadp sau"},backupPhrasePlaceholder:"ng\u1ef1a b\xe1o ch\xf3 kh\u1ec9 c\xe1 m\u1eadp h\u1ed5 v\u01b0\u1ee3n c\xe1o c\xe1 voi m\u1ef1c s\xf3i s\xf3c chu\u1ed9t s\u01b0 t\u1eed voi m\xe8o t\xf4m g\u1ea5u chim c\xe1nh c\u1ee5t h\u01b0\u01a1u r\xf9a c\xe1o ng\u1ef1a v\u1eb1n d\xea h\u01b0\u01a1u cao c\u1ed5",guide:[{title:"C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c l\xe0 m\u1ed9t lo\u1ea1i m\u1eadt kh\u1ea9u \u0111\u1eb7c bi\u1ec7t",text:"C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c l\xe0 c\xe1ch duy nh\u1ea5t \u0111\u1ec3 b\u1ea1n truy c\u1eadp v\xe0o t\xe0i kho\u1ea3n c\u1ee7a m\xecnh."},{title:"N\u1ebfu kh\xf4ng c\xf3 C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c, b\u1ea1n s\u1ebd m\u1ea5t v\u0129nh vi\u1ec5n quy\u1ec1n truy c\u1eadp",text:"N\u1ebfu b\u1ecb m\u1ea5t \u0111i\u1ec7n tho\u1ea1i, b\u1ea1n ph\u1ea3i c\xf3 C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c \u0111\u1ec3 l\u1ea5y l\u1ea1i t\xe0i kho\u1ea3n. Kh\xf4ng ai, k\u1ec3 c\u1ea3 {{appName}}, c\xf3 th\u1ec3 kh\xf4i ph\u1ee5c ti\u1ec1n c\u1ee7a b\u1ea1n khi kh\xf4ng c\xf3 C\u1ee5m t\u1eeb n\xe0y."},{title:"Vi\u1ebft ra C\u1ee5m t\u1eeb c\u1ee7a b\u1ea1n",text:"Vi\u1ebft ra C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n v\xe0 l\u01b0u gi\u1eef \u1edf n\u01a1i an to\xe0n. Kh\xf4ng l\u01b0u v\xe0o \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n."},{title:"Gi\u1eef k\xedn C\u1ee5m t\u1eeb c\u1ee7a b\u1ea1n",text:"B\u1ea5t k\u1ef3 ai c\xf3 C\u1ee5m t\u1eeb c\u1ee7a b\u1ea1n \u0111\u1ec1u s\u1ebd \u0111\u01b0\u1ee3c quy\u1ec1n truy c\u1eadp v\xe0o t\xe0i kho\u1ea3n c\u1ee7a b\u1ea1n v\xe0 t\u1ea5t c\u1ea3 ti\u1ec1n trong \u0111\xf3. Kh\xf4ng chia s\u1ebb C\u1ee5m t\u1eeb n\xe0y cho b\u1ea5t k\u1ef3 ai."}],consumerIncentivesTitle:"Ch\u01b0\u01a1ng tr\xecnh Supercharge s\u1eafp k\u1ebft th\xfac",consumerIncentivesSummary:"Nh\u01b0ng v\u1eabn c\xf2n r\u1ea5t nhi\u1ec1u ph\u1ea7n th\u01b0\u1edfng cho b\u1ea1n \u0111\u1ea5y. T\u1eeb nay \u0111\u1ebfn ng\xe0y 28 th\xe1ng 5, h\xe3y nh\u1eadn {{percent}}% ph\u1ea7n th\u01b0\u1edfng h\xe0ng n\u0103m tr\xean s\u1ed1 d\u01b0 stablecoin cao nh\u1ea5t b\u1ea1n c\xf3 (cUSD, cEUR hay cREAL). \u0110\xe2y l\xe0 c\xe1ch ch\u01b0\u01a1ng tr\xecnh ho\u1ea1t \u0111\u1ed9ng:",earnWeekly:{header:"K\u1ebft n\u1ed1i s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n",text:"Nh\u1ea5n v\xe0o K\u1ebft n\u1ed1i s\u1ed1 n\u1ebfu b\u1ea1n ch\u01b0a k\u1ebft n\u1ed1i."},noMinCommitment:{header:"Th\xeam s\u1ed1 d\u01b0 t\u1ed1i thi\u1ec3u",earningText:"Nh\u1eadn ti\u1ec1n th\u01b0\u1edfng tr\u1ecb gi\xe1 10 \u2013 1000 cUSD, 10 \u2013 1000 cEUR ho\u1eb7c 50 \u2013 6000 cREAL.",connectText:"Ch\u1ec9 c\u1ea7n c\xf3 s\u1ed1 d\u01b0 \xedt nh\u1ea5t l\xe0 {{minBalance}} {{currency}} v\xe0 k\u1ebft n\u1ed1i s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n \u0111\u1ec3 b\u1eaft \u0111\u1ea7u nh\u1eadn th\u01b0\u1edfng."},saveMoreEarnMore:{header:"Thi\u1ebft l\u1eadp C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n",text:"C\u1ee5m t\u1eeb n\xe0y \u0111\u1ea3m b\u1ea3o ti\u1ec1n th\u01b0\u1edfng \u0111\u01b0\u1ee3c an to\xe0n v\xe0 b\u1ea1n lu\xf4n n\u1eafm \u0111\u01b0\u1ee3c quy\u1ec1n ki\u1ec3m so\xe1t."},conclusion:"\u0110\u01a1n gi\u1ea3n v\u1eady th\xf4i. H\xe3y ki\u1ebfm th\xeam ti\u1ec1n \u0111i\u1ec7n t\u1eed ngay h\xf4m nay v\u1edbi Supercharge!",superchargeTitle:"Ch\u01b0\u01a1ng tr\xecnh Supercharge s\u1eafp k\u1ebft th\xfac",superchargeDescription:"Nh\u01b0ng v\u1eabn c\xf2n r\u1ea5t nhi\u1ec1u ph\u1ea7n th\u01b0\u1edfng cho b\u1ea1n \u0111\u1ea5y. T\u1eeb nay \u0111\u1ebfn ng\xe0y 28 th\xe1ng 5, h\xe3y nh\u1eadn {{apy}}% ph\u1ea7n th\u01b0\u1edfng h\xe0ng n\u0103m tr\xean s\u1ed1 d\u01b0 {{token}} cao nh\u1ea5t b\u1ea1n c\xf3. \u0110\xe2y l\xe0 c\xe1ch ch\u01b0\u01a1ng tr\xecnh ho\u1ea1t \u0111\u1ed9ng:",superchargeConnectNumber:"K\u1ebft n\u1ed1i s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n",superchargeReconnectNumber:"K\u1ebft n\u1ed1i l\u1ea1i v\u1edbi \u0111i\u1ec7n tho\u1ea1i\n<0>Ch\xfang t\xf4i \u0111\xe3 kh\u1edfi ch\u1ea1y tr\u1ea3i nghi\u1ec7m ch\u01b0\u01a1ng tr\xecnh Supercharge c\u1ea3i ti\u1ebfn. K\u1ebft n\u1ed1i l\u1ea1i s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n \u0111\u1ec3 ti\u1ebfp t\u1ee5c ki\u1ebfm ti\u1ec1n th\u01b0\u1edfng t\u1eeb {{token}}.</0>",superchargeMinimumBalance:"Th\xeam s\u1ed1 d\u01b0 t\u1ed1i thi\u1ec3u l\xe0 {{amount}} {{token}}",superchargeDisclaimer:"\u0110i\u1ec1u n\xe0y s\u1ebd kh\xf4ng \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn s\u1ed1 d\u01b0 ho\u1eb7c thu nh\u1ea