\xf3a v\u0129nh vi\u1ec5n v\xe0 kh\xf4ng th\u1ec3 kh\xf4i ph\u1ee5c. N\u1ebfu ch\u01b0a ghi l\u1ea1i C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c th\xec b\u1ea1n s\u1ebd kh\xf4ng c\xf3 c\xe1ch n\xe0o \u0111\u1ec3 l\u1ea5y l\u1ea1i.",resetNow:"Ti\u1ebfp t\u1ee5c"},protectWallet:{title:"B\u1ea3o v\u1ec7 v\xed c\u1ee7a b\u1ea1n",subtitle:"B\u1ea3o v\u1ec7 v\xed c\u1ee7a b\u1ea1n",body:"N\u1ebfu \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n b\u1ecb m\u1ea5t ho\u1eb7c b\u1ecb \u0111\xe1nh c\u1eafp, th\xec c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c g\u1ed3m 12 t\u1eeb s\u1ebd l\xe0 c\xe1ch duy nh\u1ea5t \u0111\u1ec3 b\u1ea1n truy c\u1eadp \u0111\u01b0\u1ee3c v\xe0o ti\u1ec1n c\u1ee7a m\xecnh.",recoveryPhrase:{title:"S\u1eed d\u1ee5ng C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c",subtitle:"Vi\u1ebft ra c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c"}},recoveryPhrase:{title:"C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n",titleV1_90:"C\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c c\u1ee7a b\u1ea1n",body:"H\xe3y vi\u1ebft 12 t\u1eeb n\xe0y v\xe0o m\u1ed9t n\u01a1i an to\xe0n m\xe0 kh\xf4ng ai c\xf3 th\u1ec3 \u0111\xe1nh c\u1eafp ho\u1eb7c l\xe0m h\u01b0 h\u1ecfng ch\xfang.",bodyV1_90:"N\u1ebfu l\xe0m m\u1ea5t c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c, b\u1ea1n s\u1ebd m\u1ea5t truy\u1ec1n truy c\u1eadp v\xe0o to\xe0n b\u1ed9 s\u1ed1 ti\u1ec1n b\u1ea1n n\u1eafm gi\u1eef tr\xean {{appName}}.",continue:"T\xf4i \u0111\xe3 l\u01b0u c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c",copy:"Sao ch\xe9p v\xe0o b\u1ea3ng nh\u1edb t\u1ea1m",mnemonicCopied:"\u0110\xe3 sao ch\xe9p c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c v\xe0o b\u1ea3ng nh\u1edb t\u1ea1m",bottomSheet:{title:"C\xe1ch l\u01b0u c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c",writeDownPhrase:"D\xf9ng b\xfat vi\u1ebft ra c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c v\xe0 c\u1ea5t v\xe0o m\u1ed9t n\u01a1i an to\xe0n l\xe0 m\u1ed9t trong nh\u1eefng c\xe1ch an to\xe0n nh\u1ea5t \u0111\u1ec3 b\u1ea3o v\u1ec7 v\xed c\u1ee7a b\u1ea1n.",phraseLocation:"N\u01a1i l\xfd t\u01b0\u1edfng c\xf3 th\u1ec3 l\xe0 n\u01a1i b\u1ea1n th\u01b0\u1eddng c\u1ea5t gi\u1eef c\xe1c gi\u1ea5y t\u1edd v\xe0 t\xe0i li\u1ec7u quan tr\u1ecdng kh\xe1c m\xe0 ng\u01b0\u1eddi kh\xe1c kh\xf4ng d\u1ec5 \u0111\xe1nh c\u1eafp hay l\u1ea5y \u0111i. C\xe1i \u0111\xf3 t\xf9y b\u1ea1n quy\u1ebft \u0111\u1ecbnh!"}},walletSecurityPrimer:{title:"B\u1ea3o v\u1ec7 an to\xe0n v\xed c\u1ee7a b\u1ea1n",description:"Ch\u1ec9 b\u1ea1n m\u1edbi c\xf3 th\u1ec3 truy c\u1eadp v\xe0o v\xed c\u1ee7a m\xecnh. N\u1ebfu \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n b\u1ecb m\u1ea5t ho\u1eb7c b\u1ecb \u0111\xe1nh c\u1eafp, {{appName}} s\u1ebd kh\xf4ng th\u1ec3 kh\xf4i ph\u1ee5c l\u1ea1i v\xed cho b\u1ea1n.\n\nB\u1ea1n s\u1ebd ph\u1ea3i thi\u1ebft l\u1eadp m\u1ed9t ph\u01b0\u01a1ng th\u1ee9c b\u1ea3o v\u1ec7 an to\xe0n cho v\xed v\xe0 ti\u1ec1n c\u1ee7a m\xecnh."},keylessBackupIntro:{emailAddress:"\u0110\u1ecba ch\u1ec9 email",phoneNumber:"S\u1ed1 \u0111i\u1ec7n tho\u1ea1i",setup:{title:"Thi\u1ebft l\u1eadp ch\u1ee9c n\u0103ng sao l\u01b0u v\xed.",description:"B\u1ea1n s\u1ebd s\u1eed d\u1ee5ng nh\u1eefng th\xf4ng tin sau \u0111\u1ec3 thi\u1ebft l\u1eadp sao l\u01b0u email v\xe0 s\u1ed1 \u0111i\u1ec7n tho\u1ea1i",useRecoveryPhrase:"Chuy\u1ec3n sang d\xf9ng c\u1ee5m t\u1eeb kh\xf4i ph\u1ee5c",reminder:"<0>Xin nh\u1edb r\u1eb1ng</0>, th\xf4ng tin n\xe0y l\xe0 c\xe1ch duy nh\u1ea5t \u0111\u1ec3 b\u1ea1n c\xf3 th\u1ec3 truy c\u1eadp v\xe0o v\xed trong tr\u01b0\u1eddng h\u1ee3p thi\u1ebft b\u1ecb c\u1ee7a b\u1ea1n b\u1ecb m\u1ea5t ho\u1eb7c b\u1ecb \u0111\xe1nh c\u1eafp. {{appName}} kh\xf4ng l\u01b0u gi\u1eef email ho\u1eb7c s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n. H\xe3y l\u01b0u gi\u1eef an to\xe0n th\xf4ng tin n\xe0y!"},restore:{description:"H\xe3y \u0111\u1ea3m b\u1ea3o b\u1ea1n c\xf3 s\u1eb5n nh\u1eefng th\xf4ng tin sau \u0111\u1ec3 kh\xf4i ph\u1ee5c v\xed c\u1ee7a m\xecnh.",reminder:"<0>H\xe3y nh\u1edb r\u1eb1ng</0> b\u1ea1n c\u1ea7n quy\u1ec1n truy c\u1eadp v\xe0o c\xf9ng email v\xe0 s\u1ed1 \u0111i\u1ec7n tho\u1ea1i m\xe0 b\u1ea1n \