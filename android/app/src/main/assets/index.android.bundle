r_UK:"\u0422\u0443\u0442 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u043e \u043f\u0435\u0440\u0435\u043b\u0456\u043a \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Dapps. \u0406\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f \u043f\u0440\u043e \u043a\u043e\u0436\u0435\u043d \u0456\u0437 \u043d\u0438\u0445 \u043c\u0430\u0454 \u0432\u0438\u043a\u043b\u044e\u0447\u043d\u043e \u043e\u0437\u043d\u0430\u0439\u043e\u043c\u043b\u044e\u0432\u0430\u043b\u044c\u043d\u0438\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 \u0456 \u043d\u0435 \u0454 \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u044f\u043c \u0434\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f."},dappRankings:{title:"\u0420\u0435\u0439\u0442\u0438\u043d\u0433 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 dapp",description:"\u0414\u0456\u0437\u043d\u0430\u0439\u0442\u0435\u0441\u044f \u043d\u0430\u0439\u0443\u043b\u044e\u0431\u043b\u0435\u043d\u0456\u0448\u0456 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0438 dapp \u0456\u043d\u0448\u0438\u0445 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0456\u0432 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0438 {{appName}}"},dappShortcuts:{rewards:{title:"\u0412\u0430\u0448\u0456 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438",description:"\u041e\u0442\u0440\u0438\u043c\u0430\u0439\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438 \u0437 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438\u0445 \u043f\u043e\u0437\u0438\u0446\u0456\u0439 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443 Dapp"},claimRewardsScreen:{title:"\u0412\u0430\u0448\u0456 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438",description:"\u0422\u0435\u043f\u0435\u0440 \u043c\u043e\u0436\u043d\u0430 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0