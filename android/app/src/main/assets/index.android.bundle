\u0447\u0443\u0432\u0430\u043d\u0430 \u043a\u043e\u043c\u0456\u0441\u0456\u044f",encryption:{warningLabel:"\u0426\u0435\u0439 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435 \u0431\u0443\u0434\u0435 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043e",warningModalHeader:"\u041f\u0440\u043e \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043d\u043d\u044f",warningModalBody:"\u0428\u0438\u0444\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u0456\u0441\u0442\u044c \u0432\u0430\u0448\u0438\u0445 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432. {{appName}} \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u0439, \u043a\u043e\u043b\u0438 \u0446\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u0443 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043d\u0438\u043a\u0430 \u0442\u0430 \u043e\u0434\u0435\u0440\u0436\u0443\u0432\u0430\u0447\u0430. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0446\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e, \u043a\u043e\u043b\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u044f\u0454 \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0448\u0443 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e.",feeLabel:"\u041e\u0434\u043d\u043e\u0440\u0430\u0437\u043e\u0432\u0430 \u043f\u043b\u0430\u0442\u0430 \u0437\u0430 \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043d\u043d\u044f",feeModalHeader:"\u041e\u0434\u043d\u043e\u0440\u0430\u0437\u043e\u0432\u0430 \u043f\u043b\u0430\u0442\u0430 \u0437\u0430 \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043d\u043d\u044f",feeModalBody:"\u0428\u0438\u0444\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u0456 \u0434\u0430\u043d\u0456. \u041d\u0435\u0432\u0435\u043b\u0438\u043a\u0430 \u043e\u0434\u043d\u043e\u0440\u0430\u0437\u043e\u0432\u0430 \u043f\u043b\u0430\u0442\u0430 \u0434\u043e\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0434\u043e \u0432\u0430\u0448\u043e\u0457 \u043f\u0435\u0440\u0448\u043e\u0457 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u0457 \u0434\u043b\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043d\u043d\u044f. \u0426\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454, \u0449\u043e \u0432\u0430\u0448\u0456 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 \u0431\u0443\u0434\u0443\u0442\u044c \u043d\u0430\u0434\u0456\u0439\u043d\u0438\u043c\u0438 \u0442\u0430 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u0438\u043c\u0438."},sendToAddressWarning:{title:"\u041d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u043d\u0430 \u0430\u0434\u0440\u0435\u0441\u0443",body:"\u041f\u0440\u043e\u0441\u0438\u043c\u043e \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0442\u0438\u0441\u044f, \u0449\u043e \u0446\u044f \u0430\u0434\u0440\u0435\u0441\u0430 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0438\u0439 \u0430\u043a\u0442\u0438\u0432, \u044f\u043a\u0438\u0439 \u0432\u0438 \u043d\u0430\u043c\u0430\u0433\u0430\u0454\u0442\u0435\u0441\u044f \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438. \u0412\u0430\u0448\u0456 \u043a\u043e\u0448\u0442\u0438 \u043d\u0435 \u043c\u043e\u0436\u0443\u0442\u044c \u0431\u0443\u0442\u0438 \u0432\u0456\u0434\u0448\u043a\u043e\u0434\u043e\u0432\u0430\u043d\u0456, \u044f\u043a\u0449\u043e \u0446\u044f \u0430\u0434\u0440\u0435\u0441\u0430 \u043d\u0435\u0434\u0456\u0439\u0441\u043d\u0430. \u0421\u043f\u0435\u0440\u0448\u0443 \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u0442\u0435 \u0442\u0435\u0441\u0442\u043e\u0432\u0438\u0439 \u043f\u043b\u0430\u0442\u0456\u0436, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0442\u0438\u0441\u044f, \u0449\u043e \u0446\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0430 \u0430\u0434\u0440\u0435\u0441\u0430.",toggle:"\u0417\u0430\u0432\u0436\u0434\u0438 \u043d\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438 \u043c\u0435\u043d\u0456"},loadingFromScan:"\u0421\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f",loadingFromDeeplink:"\u041f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f",action:{asking:"\u0426\u0435\u0439 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0437\u0430\u043f\u0440\u043e\u0448\u0443\u0454 \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438 \u0442\u0430\u043a\u0456 \u0434\u0456\u0457:",askingV1_35:"{{dappName}} \u0437\u0430\u043f\u0440\u043e\u0448\u0443\u0454 \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438 \u0442\u0430\u043a\u0456 \u0434\u0456\u0457:",operation:"\u041e\u043f\u0435\u0440\u0430\u0446\u0456\u044f",data:"\u0414\u0430\u043d\u0456",sign:"\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438 \u043a\u043e\u0440\u0438\u0441\u043d\u0435 \u043d\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445",signTransaction:"\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e",sendTransaction:"\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e",decrypt:"\u0420\u043e\u0437\u0448\u0438\u0444\u0440\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0440\u0438\u0441\u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445",accounts:"\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0430\u0434\u0440\u0435\u0441\u0443 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443 {{appName}}",details:"\u0414\u0430\u043d\u0456 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u0457",computeSharedSecret:"\u0413\u0435\u043d\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0441\u0435\u043a\u0440\u0435\u0442\u0438",emptyMessage:"\u041f\u043e\u0440\u043e\u0436\u043d\u0454 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f"},walletConnectRequest:{transactionDataLabel:"\u0414\u0430\u043d\u0456 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u0457",readAccount:"{{dappName}} \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0437\u0447\u0438\u0442\u0430\u0442\u0438 \u0430\u0434\u0440\u0435\u0441\u0443 \u0433\u0430\u043c\u0430\u043d\u0446\u044f {{appName}}.",signPayloadTitle:"\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",signPayload:"{{dappName}} \u043d\u0430\u043c\u0430\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u043f\u0440\u0430\u0432\u0430 \u0432\u043b\u0430\u0441\u043d\u043e\u0441\u0442\u0456 \u043d\u0430 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c.",signTransactionTitle:"\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u044e",signTransaction:"{{dappName}} \u0431\u0430\u0436\u0430\u0454 \u043f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e.",signDappTransaction:"{{dappName}} \u0431\u0430\u0436\u0430\u0454 \u043f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e \u0432 \u043c\u0435\u0440\u0435\u0436\u0456 {{networkName}}.",signDappTransactionUnsupportedNetwork:"{{dappName}} \u0431\u0430\u0436\u0430\u0454 \u043f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e \u0432 \u043c\u0435\u0440\u0435\u0436\u0456, \u0449\u043e \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f.",sendTransactionTitle:"\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e",sendTransaction:"{{dappName}} \u0431\u0430\u0436\u0430\u0454 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e.",sendDappTransaction:"{{dappName}} \u0431\u0430\u0436\u0430\u0454 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e \u0432 \u043c\u0435\u0440\u0435\u0436\u0456 {{networkName}}.",sendDappTransactionUnsupportedNetwork:"{{dappName}} \u0431\u0430\u0436\u0430\u0454 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e \u0432 \u043c\u0435\u0440\u0435\u0436\u0456, \u0449\u043e \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f.",decryptPayloadTitle:"\u0420\u043e\u0437\u0448\u0438\u0444\u0440\u0443\u0432\u0430\u0442\u0438, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0447\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",decryptPayload:"{{dappName}} \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0440\u043e\u0437\u0448\u0438\u0444\u0440\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u0439 \u0432\u043c\u0456\u0441\u0442 \u0434\u0430\u043d\u0438\u0445.",computeSharedSecret:"{{dappName}} \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0437\u0433\u0435\u043d\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u0456 \u043a\u043e\u0434\u0438.",transactionDataCopied:"\u0414\u0430\u043d\u0456 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u0457 \u0441\u043a\u043e\u043f\u0456\u0439\u043e\u0432\u0430\u043d\u043e",estimatedNetworkFee:"\u041e\u0440\u0456\u0454\u043d\u0442\u043e\u0432\u043d\u0430 \u043a\u043e\u043c\u0456\u0441\u0456\u044f \u0437\u0430 \u043c\u0435\u0440\u0435\u0436\u0443 {{networkName}}",networksList:"\u041c\u0435\u0440\u0435\u0436\u0456",connectWalletAction:"\u041f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",signTransactionAction:"\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438",sendTransactionAction:"\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438",unsupportedChain:{title:"\u041d\u0435\u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0438\u0439 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a",description:"{{dappName}} \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0454 \u0437\u0430\u043f\u0438\u0442 \u0449\u043e\u0434\u043e \u0446\u0456\u0454\u0457 \u0434\u0456\u0457 \u043d\u0430 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a, \u044f\u043a\u0438\u0439 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u043e\u043c {{appName}}. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e Celo \u0454 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u043c \u043b\u0430\u043d\u0446\u044e\u0436\u043a\u043e\u043c \u043d\u0430 \u0431\u043e\u0446\u0456 Dapp.",descriptionV1_74_one:"{{dappName}} \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0454 \u0437\u0430\u043f\u0438\u0442 \u0449\u043e\u0434\u043e \u0446\u0456\u0454\u0457 \u0434\u0456\u0457 \u043d\u0430 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a, \u044f\u043a\u0438\u0439 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u043e\u043c {{appName}}. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e {{supportedNetworkNames}} \u0454 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u043c \u043b\u0430\u043d\u0446\u044e\u0436\u043a\u043e\u043c \u043d\u0430 \u0431\u043e\u0446\u0456 Dapp.",descriptionV1_74_other:"{{dappName}} \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0454 \u0437\u0430\u043f\u0438\u0442 \u0449\u043e\u0434\u043e \u0446\u0456\u0454\u0457 \u0434\u0456\u0457 \u043d\u0430 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a, \u044f\u043a\u0438\u0439 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u043e\u043c {{appName}}. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a \u043d\u0430 dapp \u0454 \u043e\u0434\u043d\u0438\u043c \u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0445: {{supportedNetworkNames}}."},notEnoughBalanceForGas:{title:"\u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043d\u0456\u0439 \u0437\u0430\u043b\u0438\u0448\u043e\u043a \u0442\u043e\u043a\u0435\u043d\u0456\u0432 \u0434\u043b\u044f \u043a\u043e\u043c\u0456\u0441\u0456\u0457 \u0437\u0430 \u0433\u0430\u0437",description:"\u0423 \u0432\u0430\u0441 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e {{feeCurrencies}}, \u0449\u043e\u0431 \u043f\u043e\u043a\u0440\u0438\u0442\u0438 \u043a\u043e\u043c\u0456\u0441\u0456\u0457 \u0437\u0430 \u0433\u0430\u0437. \u0414\u043e\u0434\u0430\u0439\u0442\u0435 {{feeCurrencies}} \u0434\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u0433\u0430\u043c\u0430\u043d\u0446\u044f, \u0449\u043e\u0431 \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e."},failedToPrepareTransaction:{title:"\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0456\u0434\u0433\u043e\u0442\u0443\u0432\u0430\u0442\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u044e",description:"\u041f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0456\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0456\u0457 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u043e\u043c\u0438\u043b\u043a\u0430. \u0414\u043e\u043a\u043b\u0430\u0434\u043d\u0456\u0448\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u0434\u0438\u0432\u0456\u0442\u044c\u0441\u044f \u0432 \u043e\u043f\u0438\u0441\u0456 \u043f\u0440\u043e \u043f\u043e\u043c\u0438\u043b\u043a\u0443.\n\n\"{{errorMessage}}\""},session:{failUnsupportedNamespace:{title:"\u041d\u0435\u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0438\u0439 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a",description:"{{dappName}} \u043d\u0430\u043c\u0430\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0434\u043e \u043b\u0430\u043d\u0446\u044e\u0436\u043a\u0430, \u044f\u043a\u0438\u0439 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f {{appName}}. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0437 \u0431\u043e\u043a\u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443 Dapp \u0432\u0438\u0431\u0440\u0430\u043d\u043e Celo.",descriptionV1_74_one:"{{dappName}} \u043d\u0430\u043c\u0430\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0434\u043e \u043b\u0430\u043d\u0446\u044e\u0436\u043a\u0430, \u044f\u043a\u0438\u0439 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f {{appName}}. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0437 \u0431\u043e\u043a\u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443 Dapp \u0432\u0438\u0431\u0440\u0430\u043d\u043e {{supportedNetworkNames}}.",descriptionV1_74_other:"{{dappName}} \u043d\u0430\u043c\u0430\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f \u0434\u043e \u043b\u0430\u043d\u0446\u044e\u0436\u043a\u0430, \u044f\u043a\u0438\u0439 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f {{appName}}. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a \u043d\u0430 dapp \u0454 \u043e\u0434\u043d\u0438\u043c \u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0445: {{supportedNetworkNames}}."},warnUnsupportedChains:{title:"\u041d\u0435\u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0438\u0439 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a",description:"\u0423 {{dappName}} Celo \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u044f\u043a \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0438\u0439 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a. \u0414\u0435\u044f\u043a\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043b\u043e\u0441\u044f.",descriptionV1_74_one:"\u0423 {{dappName}} {{supportedNetworkNames}} \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u044f\u043a \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0438\u0439 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a. \u0414\u0435\u044f\u043a\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043b\u043e\u0441\u044f.",descriptionV1_74_other:"{{dappName}} \u043d\u0435 \u0432\u043a\u0430\u0437\u0430\u043b\u0438 \u0436\u043e\u0434\u043d\u043e\u0433\u043e \u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0445 \u043b\u0430\u043d\u0446\u044e\u0436\u043a\u0456\u0432 \u044f\u043a \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0456: {{supportedNetworkNames}}. \u0414\u0435\u044f\u043a\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043b\u043e\u0441\u044f."},warnSomeUnsupportedMethods:{title:"\u041d\u0435\u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0456 \u0441\u043f\u043e\u0441\u043e\u0431\u0438",description:"\u0423 {{dappName}} \u0437\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u0434\u0435\u044f\u043a\u0456 \u0441\u043f\u043e\u0441\u043e\u0431\u0438, \u0449\u043e \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c\u0441\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u043e\u043c {{appName}}. \u0414\u0435\u044f\u043a\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u043e\u0447\u0456\u043a\u0443\u0432\u0430\u043b\u043e\u0441\u044f."},warnSomeUnsupportedEvents:{title:"\u041d\u0435\u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0456 \u0437\u0430\u0445\u043e\u0434\u0438",description:"\u0423 {{dappName}} \u0437\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043e \u0434\u0435\u044f\u043a\u0456 \u043