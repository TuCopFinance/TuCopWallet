38\u0445\u043e\u043e\u043a\u0435\u0430\u043d\u0441\u043a\u043e\u043c\u0443 \u043b\u0435\u0442\u043d\u0435\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\u042d\u0442\u043e \u044d\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u043e\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u044b\u043c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c Ethereum.",expirationLabel:"\u0418\u0441\u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u0440\u043e\u043a\u0430 {{expirationLabelText}}",cta:"\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u0435"},rewardReminderBottomSheet:{title:"\u041d\u0435 \u0443\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0441\u0432\u043e\u0439 \u0448\u0430\u043d\u0441 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c 5 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0432 ETH",description:"\u041f\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0441\u0432\u043e\u0439 \u043a\u043e\u0448\u0435\u043b\u0435\u043a \u043b\u044e\u0431\u044b\u043c \u0442\u043e\u043a\u0435\u043d\u043e\u043c Ethereum \u0434\u043e 12:00 \u043f\u043e \u0442\u0438\u0445\u043e\u043e\u043a\u0435\u0430\u043d\u0441\u043a\u043e\u043c\u0443 \u043b\u0435\u0442\u043d\u0435\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 4 \u0430\u043f\u0440\u0435\u043b\u044f 2024 \u0433\u043e\u0434\u0430, \u0438 \u043c\u044b \u043f\u043e\u0434\u0430\u0440\u0438\u043c \u0432\u0430\u043c 5 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0432 ETH 5 \u0430\u043f\u0440\u0435\u043b\u044f 2024 \u0433\u043e\u0434\u0430 \u0432 11:59 \u043f\u043e \u0442\u0438\u0445\u043e\u043e\u043a\u0435\u0430\u043d\u0441\u043a\u043e\u043c\u0443 \u043b\u0435\u0442\u043d\u0435\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\n\n\u042d\u0442\u043e \u044d\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\