heet:{title:"\u0417\u0430\u0440\u043e\u0431\u0438\u0442\u0438 5 \u0434\u043e\u043b\u0430\u0440\u0456\u0432 \u0421\u0428\u0410 \u0432 ETH",description:"\u041f\u043e\u043f\u043e\u0432\u043d\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u043c \u0442\u043e\u043a\u0435\u043d\u043e\u043c Ethereum \u0434\u043e 12:00 \u0437\u0430 PDT 4 \u043a\u0432\u0456\u0442\u043d\u044f 2024 \u0440\u043e\u043a\u0443, \u0456 \u043c\u0438 \u043d\u0430\u0440\u0430\u0445\u0443\u0454\u043c\u043e \u0432\u0430\u043c $5 \u0443 ETH \u0434\u043e 23:59 \u0437\u0430 PDT 5 \u043a\u0432\u0456\u0442\u043d\u044f 2024 \u0440\u043e\u043a\u0443.\n\n\u0426\u0435 \u0435\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u0430 \u043f\u0440\u043e\u043f\u043e\u0437\u0438\u0446\u0456\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0456\u0434\u043d\u0438\u043a\u0430 Early Ethereum.",expirationLabel:"\u0414\u0456\u0439\u0441\u043d\u043e \u0434\u043e {{expirationLabelText}}",cta:"\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0443"},rewardReminderBottomSheet:{title:"\u041d\u0435 \u0437\u043c\u0430\u0440\u043d\u0443\u0439\u0442\u0435 \u0448\u0430\u043d\u0441 \u0437\u0430\u0440\u043e\u0431\u0438\u0442\u0438 $5 \u0443 ETH",description:"\u041f\u043e\u043f\u043e\u0432\u043d\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u043c \u0442\u043e\u043a\u0435\u043d\u043e\u043c Ethereum \u0434\u043e 12:00 \u0437\u0430 PDT 4 \u043a\u0432\u0456\u0442\u043d\u044f 2024 \u0440\u043e\u043a\u0443, \u0456 \u043c\u0438 \u043d\u0430\u0440\u0430\u0445\u0443\u0454\u043c\u043e \u0432\u0430\u043c $5 \u0443 ETH \u0434\u043e 23:59 \u0437\u0430 PDT 5 \u043a\u0432\u0456\u0442\u043d\u044f 2024 \u0440\u043e\u043a\u0443.\n\n\u0426\u0435 \u0435\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043