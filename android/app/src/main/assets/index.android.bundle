0\u0441\u043f\u0440\u0430\u0432\u0434\u0456 \u043d\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0430\u043c, \u0432\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u0454\u0442\u0435 \u0442\u0440\u0438 SMS-\u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u0456 \u043a\u043e\u0448\u0442\u0443\u0432\u0430\u0442\u0438\u043c\u0443\u0442\u044c \u0431\u043b\u0438\u0437\u044c\u043a\u043e 0,5 cUSD \u043a\u043e\u0436\u043d\u0435.\n\n\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u043d\u043e\u043c\u0435\u0440\u0443 \u0437\u0430\u0431\u0438\u0440\u0430\u0454 \u0431\u043b\u0438\u0437\u044c\u043a\u043e \u0442\u0440\u044c\u043e\u0445 \u0445\u0432\u0438\u043b\u0438\u043d.",feelessBody:"\u0412\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u0454\u0442\u0435 \u0442\u0440\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u043e \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443. \u0429\u043e\u0431 \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438 \u043d\u043e\u043c\u0435\u0440, \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0431\u043b\u0438\u0437\u044c\u043a\u043e \u0442\u0440\u044c\u043e\u0445 \u0445\u0432\u0438\u043b\u0438\u043d.",start:"\u041f\u043e\u0447\u0430\u0442\u0438",resume:"\u041f\u043e\u043d\u043e\u0432\u0438\u0442\u0438",doINeedToConfirm:"\u041f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438?",skipForNow:"\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0437\u0430\u0440\u0430\u0437",bodyInsufficientBalance:"\u0412\u0430\u0448\u043e\u0433\u043e \u043f\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0437\u0430\u043b\u0438\u0448\u043a\u0443 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e, \u0449\u043e\u0431 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u043f\u0440\u043e\u0446\u0435\u0441 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f.\n\n\u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437, \u043a\u043e\u043b\u0438 \u0432\u0438 \u0434\u043e\u0434\u0430\u0441\u0442\u0435 \u043a\u043e\u0448\u0442\u0438 \u0434\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u0433\u0430\u043c\u0430\u043d\u0446\u044f.",bodyAlreadyVerified:"\u0412\u0430\u0448 \u043d\u043e\u043c\u0435\u0440 \u0443\u0436\u0435 \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043e!"},verificationSkipDialog:{title:"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456?",body:"\u041a\u043e\u043b\u0438 \u043d\u043e\u043c\u0435\u0440 \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043e, \u043c\u043e\u0436\u043d\u0430 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u0439 \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0448\u0442\u0438 \u043d\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443.\n\n\u041e\u0431\u043b\u0456\u043a\u043e\u0432\u0456 \u0437\u0430\u043f\u0438\u0441\u0438, \u044f\u043a\u0456 \u043d\u0435 \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043e, \u043c\u043e\u0436\u0443\u0442\u044c \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u043f\u043b\u0430\u0442\u0435\u0436\u0456 \u0442\u0456\u043b\u044c\u043a\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0430\u0434\u0440\u0435\u0441 \u0433\u0430\u043c\u0430\u043d\u0446\u0456\u0432 \u0430\u0431\u043e QR-\u043a\u043e\u0434\u0456\u0432.",cancel:"\u041f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f",confirm:"\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0437\u0430\u0440\u0430\u0437"},verificationPrematureRevealMessage:"\u0417\u0430\u0447\u0435\u043a\u0430\u0439\u0442\u0435 \u043e\u0434\u043d\u0443 \u0445\u0432\u0438\u043b\u0438\u043d\u0443 \u0434\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f",verificationLearnMoreDialog:{title:"\u041d\u043e\u043c\u0435\u0440\u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456\u0432 \u0456 {{appName}}",body:"\u041f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u0439 \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0448\u0442\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0432\u0430\u0448\u043e\u0433\u043e \u043d\u043e\u043c\u0435\u0440\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443.\n\n<0>\u0427\u0438 \u043c\u043e\u0436\u043d\u0430 \u0446\u0435 \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u043f\u0456\u0437\u043d\u0456\u0448\u0435?</0>\n\n\u0422\u0430\u043a, \u0430\u043b\u0435 \u043d\u0435\u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u0456 \u0433\u0430\u043c\u0430\u043d\u0446\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u043f\u043b\u0430\u0442\u0435\u0436\u0456 \u043b\u0438\u0448\u0435 \u0437\u0430 QR-\u043a\u043e\u0434\u0430\u043c\u0438 \u0430\u0431\u043e \u0430\u0434\u0440\u0435\u0441\u0430\u043c\u0438 \u0440\u0430\u0445\u0443\u043d\u043a\u0456\u0432.\n\n<1>\u0411\u0435\u0437\u043f\u0435\u043a\u0430 \u0442\u0430 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u0456\u0441\u0442\u044c</1>\n\n{{appName}} \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0441\u0443\u0447\u0430\u0441\u043d\u0456 \u043c\u0435\u0442\u043e\u0434\u0438 \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u0456\u0441\u0442\u044c \u0432\u0430\u0448\u043e\u0433\u043e \u043d\u043e\u043c\u0435\u0440\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443.",dismiss:"\u0412\u0456\u0434\u0445\u0438\u043b\u0438\u0442\u0438"},phoneVerificationScreen:{screenTitle:"\u041d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443",title:"\u041f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0441\u0432\u0456\u0439 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0434\u043e {{appName}}",description:"\u0422\u0430\u043a \u0432\u0438 \u043f\u0440\u0438\u0432\u2019\u044f\u0436\u0435\u0442\u0435 \u0430\u0434\u0440\u0435\u0441\u0443 \u0433\u0430\u043c\u0430\u043d\u0446\u044f \u0434\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u043d\u043e\u043c\u0435\u0440\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443, \u0442\u043e\u043c\u0443 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u043a\u0440\u0438\u043f\u0442\u043e\u0432\u0430\u043b\u044e\u0442\u0443 \u0431\u0443\u0434\u0435 \u043b\u0435\u0433\u043a\u043e",startButtonLabel:"\u041f\u0456\u0434'\u0454\u0434\u043d\u0430\u0442\u0438\u0441\u044f",learnMore:{buttonLabel:"\u041f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438?",title:"\u041f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438?",body:"\u041f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u043d\u043e\u043c\u0435\u0440\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c \u0432\u0430\u043c \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u0433\u0440\u043e\u0448\u0456 \u0434\u0440\u0443\u0437\u044f\u043c, \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u043c \u0443 \u0432\u0430\u0448\u0456\u0439 \u0430\u0434\u0440\u0435\u0441\u043d\u0456\u0439 \u043a\u043d\u0438\u0437\u0456, \u0442\u0430 \u043d\u0430 \u0456\u043d\u0448\u0456 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u0456 \u043d\u043e\u043c\u0435\u0440\u0438. \n\n\u042f\u043a\u0449\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0446\u0435\u0439 \u043a\u0440\u043e\u043a, \u0442\u043e \u0432\u0438 \u043d\u0435 \u043e\u0442\u0440\u0438\u043c\u0430\u0454\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0432\u0430\u0448\u0438\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0456\u0432 \u0456 \u0437\u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u0433\u0440\u043e\u0448\u0456 \u0442\u0456\u043b\u044c\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 QR-\u043a\u043e\u0434 \u0430\u0431\u043e \u0430\u0434\u0440\u0435\u0441\u0443 \u0433\u0430\u043c\u0430\u043d\u0446\u044f."},skip:{title:"\u0412\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456?",body:"\u041f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438 \u0442\u0430 \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0448\u0442\u0438 \u0437 \u0432\u0430\u0448\u043e\u0433\u043e \u043d\u043e\u043c\u0435\u0440\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443.",cancel:"\u041f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f",confirm:"\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0437\u0430\u0440\u0430\u0437"}},phoneVerificationInput:{title:"\u0423\u0432\u0435\u0434\u0456\u0442\u044c \u043a\u043e\u0434",description:"\u041c\u0438 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043b\u0438 \u043a\u043e\u0434 \u043d\u0430 {{phoneNumber}}. \u0423\u0432\u0435\u0434\u0456\u0442\u044c \u0439\u043e\u0433\u043e \u043d\u0438\u0436\u0447\u0435.",help:"\u0414\u043e\u0432\u0456\u0434\u043a\u0430",codeInputPlaceholder:"123456",helpDialog:{title:"\u0414\u043e\u0432\u0456\u0434\u043a\u0430",body:"\u041c\u0438 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043b\u0438 SMS \u043d\u0430 \u0432\u0430\u0448 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0432\u0430\u0448\u0456 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0456 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u043d\u0430\u0439\u0442\u0438 \u043a\u043e\u0434 \u0456\u0437 6 \u0446\u0438\u0444\u0440. \n\n\u042f\u043a\u0449\u043e \u0443 \u0432\u0430\u0441 \u0432\u0438\u043d\u0438\u043a\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0437 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f\u043c \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c, \u043d\u0430\u0440\u0430\u0437\u0456 \u043c\u043e\u0436\u043d\u0430 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0446\u0435\u0439 \u043a\u0440\u043e\u043a \u0456 \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 \u0437\u043d\u043e\u0432\u0443 \u043f\u0456\u0437\u043d\u0456\u0448\u0435.",bodyCloudBackupOnboarding:"\u041c\u0438 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043b\u0438 SMS \u043d\u0430 \u0432\u0430\u0448 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0456 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u043d\u0430\u0439\u0442\u0438 6-\u0437\u043d\u0430\u0447\u043d\u0438\u0439 \u043a\u043e\u0434. \n \n \u042f\u043a\u0449\u043e \u0443 \u0432\u0430\u0441 \u0432\u0438\u043d\u0438\u043a\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0437 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f\u043c \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u043c\u043e \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443 \u043a\u043e\u043f\u0456\u044e \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0440\u0430\u0437\u0438 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f. \u041f\u0456\u0437\u043d\u0456\u0448\u0435 \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 \u0443\u0432\u0456\u0439\u0442\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0457 \u043f\u043e\u0448\u0442\u0438 \u0442\u0430 \u043d\u043e\u043c\u0435\u0440\u0443 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443.",skip:"\u041f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438",dismiss:"\u041f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f",useRecoveryPhrase:"\u0421\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044f \u0444\u0440\u0430\u0437\u043e\u044e \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f"},verificationFailure:"\u0429\u043e\u0441\u044c \u043f\u0456\u0448\u043b\u043e \u043d\u0435 \u0442\u0430\u043a. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437 \u043f\u0456\u0437\u043d\u0456\u0448\u0435.",resendButtonNotYetAvailable:"\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043c\u043e\u0436\u043d\u0430 \u0447\u0435\u0440\u0435\u0437 {{secondsRemaining}} \u0441\u0435\u043a",resendButton:"\u041d\u0435 \u043e\u0442\u0440\u0438\u043c\u0430\u043b\u0438 \u043a\u043e\u0434?"},importExistingKey:{keyPlaceholder:"\u043a\u0456\u043d\u044c \u043b\u0435\u043e\u043f\u0430\u0440\u0434 \u0441\u043e\u0431\u0430\u043a\u0430 \u043c\u0430\u0432\u043f\u0430 ...",header:"\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",title:"\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0444\u0440\u0430\u0437\u0443 \u0434\u043b\u044f \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",description:"\u0417\u0430\u0437\u043d\u0430\u0447\u0442\u0435 \u0444\u0440\u0430\u0437\u0443 \u0437 12 \u0430\u0431\u043e 24 \u0441\u043b\u0456\u0432, \u044f\u043a\u0443 \u0432\u0438 \u0437\u0431\u0435\u0440\u0435\u0433\u043b\u0438 \u043f\u0456\u0434 \u0447\u0430\u0441 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u0456\u0437 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0433\u0430\u043c\u0430\u043d\u0446\u044f.",descriptionV1_90:"\u0412\u0430\u0448\u0430 \u0444\u0440\u0430\u0437\u0430 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u2013 \u0446\u0435 \u0444\u0440\u0430\u0437\u0430 \u0437 12 \u0430\u0431\u043e 24 \u0441\u043b\u0456\u0432, \u044f\u043a\u0443 \u0432\u0438 \u0437\u0430\u043f\u0438\u0441\u0430\u043b\u0438 \u0442\u0430 \u0437\u0431\u0435\u0440\u0435\u0433\u043b\u0438 \u043f\u0456\u0434 \u0447\u0430\u0441 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u043e\u0433\u043e \u0433\u0430\u043c\u0430\u043d\u0446\u044f. \u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0457\u0457 \u0442\u0443\u0442, \u0449\u043e\u0431 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c.",emptyWalletDialog:{description:"\u0423 \u0446\u044c\u043e\u043c\u0443 \u0433\u0430\u043c\u0430\u043d\u0446\u0456 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u0448\u0442\u0456\u0432. \u0412\u0438 \u0432\u0441\u0435 \u0449\u0435 \u0445\u043e\u0442\u0456\u043b\u0438 \u0431 \u0439\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438?",action:"\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",title:"\u0417\u0430\u043b\u0438\u0448\u043e\u043a\n<0></0>"}},importSelect:{title:"\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",description:"\u041f\u0456\u0434 \u0447\u0430\u0441 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u0457 \u043a\u043e\u043f\u0456\u0457 \u0434\u043b\u044f \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0433\u0430\u043c\u0430\u043d\u0446\u044f \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043d\u0438\u0436\u0447\u0435 \u0432\u0430\u0440\u0456\u0430\u043d\u0442.",emailAndPhone:{title:"\u0417\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u044e \u043a\u043e\u043f\u0456\u0454\u044e \u0430\u0434\u0440\u0435\u0441\u0438 \u0435\u043b. \u043f\u043e\u0448\u0442\u0438 \u0439 \u043d\u043e\u043c\u0435\u0440\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443",description:"\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c \u0437\u0430 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0430\u043d\u0438\u043c\u0438 \u043d\u043e\u043c\u0435\u0440\u043e\u043c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0439 \u0430\u0434\u0440\u0435\u0441\u043e\u044e \u0435\u043b. \u043f\u043e\u0448\u0442\u0438"},recoveryPhrase:{title:"\u0417\u0430 \u0444\u0440\u0430\u0437\u043e\u044e \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",description:"\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0444\u0440\u0430\u0437\u0443 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0437 12 \u0441\u043b\u0456\u0432, \u0449\u043e\u0431 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e {{appName}}"}},verificationInput:{title:"\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438",body:"\u041c\u0438 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043b\u0438 \u0432\u0430\u043c \u0442\u0440\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f (SMS). \u0421\u043a\u043e\u043f\u0456\u044e\u0439\u0442\u0435 \u0442\u0430 \u0432\u0441\u0442\u0430\u0432\u0442\u0435 \u0457\u0445 \u043d\u0438\u0436\u0447\u0435.",body_ios:"\u041c\u0438 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043b\u0438 \u0432\u0430\u043c \u0442\u0440\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f (SMS). \u041f\u0440\u043e\u0441\u0438\u043c\u043e, \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0432 \u043a\u043e\u0436\u043d\u043e\u043c\u0443 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u0456, \u0449\u043e\u0431 \u0437\u0430\u043f\u043e\u0432\u043d\u0438\u0442\u0438 \u043a\u043e\u0434\u0438 \u043d\u0438\u0436\u0447\u0435, \u0430\u0431\u043e \u0441\u043a\u043e\u043f\u0456\u044e\u0439\u0442\u0435 \u0457\u0445 \u0442\u0430 \u0432\u0441\u0442\u0430\u0432\u0442\u0435 \u0432\u0440\u0443\u0447\u043d\u0443.",body_short:"\u041c\u0438 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u043b\u0438 \u0442\u0440\u0438 \u043a\u043e\u0434\u0438 \u043d\u0430 {{phoneNumber}}. \u041f\u0440\u043e\u0441\u0438\u043c\u043e, \u0432\u0432\u0435\u0434\u0456\u0442\u044c \u0457\u0445 \u043d\u0438\u0436\u0447\u0435.",codeLabel1:"\u041f\u0435\u0440\u0448\u0438\u0439 \u043a\u043e\u0434",codeLabel2:"\u0414\u0440\u0443\u0433\u0438\u0439 \u043a\u043e\u0434",codeLabel3:"\u0422\u0440\u0435\u0442\u0456\u0439 \u043a\u043e\u0434",codePlaceholder1:"\u0421\u043a\u043e\u043f\u0456\u044e\u0432\u0430\u0442\u0438 \u043f\u0435\u0440\u0448\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",codePlaceholder1_ios:"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u0430\u0431\u043e \u0441\u043a\u043e\u043f\u0456\u044e\u0439\u0442\u0435 \u043f\u0435\u0440\u0448\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",codePlaceholder2:"\u0421\u043a\u043e\u043f\u0456\u044e\u0432\u0430\u0442\u0438 \u0434\u0440\u0443\u0433\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",codePlaceholder2_ios:"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u0430\u0431\u043e \u0441\u043a\u043e\u043f\u0456\u044e\u0439\u0442\u0435 \u0434\u0440\u0443\u0433\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",codePlaceholder3:"\u0421\u043a\u043e\u043f\u0456\u044e\u0432\u0430\u0442\u0438 \u0442\u0440\u0435\u0442\u0454 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",codePlaceholder3_ios:"\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u0430\u0431\u043e \u0441\u043a\u043e\u043f\u0456\u044e\u0439\u0442\u0435 \u0442\u0440\u0435\u0442\u0454 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",codePlaceholderWithCodeInClipboard:"\u0427\u0443\u0434\u043e\u0432\u043e! \u0412\u0441\u0442\u0430\u0432\u0442\u0435 \u0439\u043e\u0433\u043e \u0442\u0443\u0442",resendMessages_all:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0432\u0441\u0456 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",resendMessages_0:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u043e\u0441\u0442\u0430\u043d\u043d\u0454 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",resendMessages_1:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f: {{count}}",resendMessages_2:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f: {{count}}",resendMessages_3:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 {{count}} \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c"},verificationInputHelpDialog:{title:"\u0414\u043e\u0432\u0456\u0434\u043a\u0430",bodySection1:{title:"\u041e\u0442\u0440\u0438\u043c\u0430\u043d\u043e \u0432\u0441\u0456 \u0442\u0440\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f?",content:"\u042f\u043a\u0449\u043e \u0432\u0430\u0448\u0456 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043c\u0456\u0441\u0442\u044f\u0442\u044c \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f, \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043d\u0430 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0434\u043b\u044f \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f.\n\n\u042f\u043a\u0449\u043e \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u044c \u043d\u0435\u043c\u0430\u0454, \u043f\u0440\u043e\u0441\u0438\u043c\u043e \u0441\u043a\u043e\u043f\u0456\u044e\u0432\u0430\u0442\u0438 \u0442\u0430 \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0432 \u043f\u043e\u043b\u044f. \u0412\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0432\u0441\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f."},bodySection2:{title:"\u041d\u0435\u043c\u0430\u0454 \u0434\u0435\u044f\u043a\u0438\u0445 \u0447\u0438 \u0432\u0441\u0456\u0445 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c?",defaultContent:"\u042f\u043a\u0449\u043e \u0443 \u0432\u0430\u0441 \u0432\u0438\u043d\u0438\u043a\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0437 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f\u043c \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u0440\u0430\u0437 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0446\u0435\u0439 \u043a\u0440\u043e\u043a \u0456 \u0441\u043f\u0440\u043e\u0431\u04