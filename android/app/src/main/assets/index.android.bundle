otalSupplied:"Total depositado",depositAndEarnings:"Dep\xf3sitos y ganancias",myPools:"Mis pools",explore:"Explorar opciones"},depositBottomSheet:{title:"Revisar y depositar",description:"Antes de depositar en una pool de Aave, revisa los detalles de la transacci\xf3n a continuaci\xf3n",descriptionV1_93:"Antes de depositar en un pool {{providerName}}, revisa los detalles de la transacci\xf3n a continuaci\xf3n",amount:"Monto depositado",fee:"Tarifas estimadas",provider:"Proveedor de ganancias",network:"Red",footer:"Al depositar cripto en una pool de Aave, aceptas los riesgos asociados a su uso. <0>T\xe9rminos y condiciones</0>",footerV1_93:"Al depositar cripto en un pool de {{providerName}}, aceptas los riesgos asociados al uso de {{providerName}}. <0>T\xe9rminos y condiciones</0>",noTermsUrlFooter:"Eres responsable de tus acciones en {{appName}}. {{appName}} no asume ninguna responsabilidad por tus activos o interacciones con {{providerName}}. Puedes consultar los documentos de {{providerName}} <0>aqu\xed</0> y nuestros T\xe9rminos y Condiciones <1>aqu\xed</1>.",primaryCta:"Finalizar",secondaryCta:"Cancelar",yieldRate:"Tasa de rendimiento (est.)",apy:"{{apy}}%",yieldRateV2:"Tasa de inter\xe9s m.v."},collect:{title:"\xa1Felicidades! Revisa y recoge tus ganancias",titleClaim:"Reclamar\xe1s:",titleCollect:"Recibir\xe1s:",titleWithdraw:"Retirar\xe1s:",total:"TOTAL",plus:"M\xc1S",reward:"RECOMPENSA",rate:"Tasa (est.)",apy:"APY {{apy}}%",fee:"Tarifa estimada",cta:"Recoger ganancias",ctaWithdraw:"Retirar",ctaReward:"Reclamar recompensa",ctaExit:"Retirar todo",errorTitle:"Algo sali\xf3 mal",errorDescription:"No fue posible obtener los datos del dep\xf3sito. Vuelve a intentarlo.",noGasTitle:"Necesitas m\xe1s {{symbol}} para continuar",noGasDescription:"Agrega {{symbol}} en {{network}} para cubrir tus tarifas",noGasCta:"Compra {{symbol}} en {{network}}"},transactionFeed:{earnClaimTitle:"Ganancias recibidas",earnClaimSubtitle:"de la pool {{providerName}}",earnDepositTitle:"Fondos depositados",earnDepositSubtitle:"en la pool {{providerName}}",earnWithdrawTitle:"Fondos retirados",earnWithdrawSubtitle:"de la pool {{providerName}}"},transactionDetails:{descriptionLabel:"Detalles",earnClaimTitle:"Ganancias recibidas",earnClaimSubtitle:"{{tokenSymbol}} recibidos de la pool {{providerName}}",earnClaimDetails:"Monto recibido",earnDepositTitle:"Fondos depositados",earnDepositSubtitle:"{{tokenSymbol}} depositados en la pool {{providerName}}",earnDepositDetails:"Monto depositado",earnWithdrawTitle:"Fondos retirados",earnWithdrawSubtitle:"{{tokenSymbol}} retirados de la pool {{providerName}}",earnWithdrawDetails:"Monto retirado",swap:"Cambio",network:"Red",fees:"Tarifas"},home:{title:"Tu dinero crece",learnMore:"<0>M\xe1s informaci\xf3n</0> sobre las pools de rendimiento.",learnMoreBottomSheet:{bottomSheetTitle:"M\xe1s informaci\xf3n sobre la pools de rendimiento",apySubtitle:"\xbfQu\xe9 es el APY?",apyDescription:"El rendimiento porcentual anual (APY) es una m\xe9trica utilizada para calcular el rendimiento anualizado de las inversiones cripto. Es un indicador clave del rendimiento y la rentabilidad potenciales de una criptomoneda.",tvlSubtitle:"\xbfQu\xe9 es el TVL?",tvlDescription:"El valor total bloqueado (TVL) es una m\xe9trica utilizada en la industria cripto para medir el valor de los activos digitales bloqueados en una red. El TVL se calcula sumando el valor de todos los activos digitales bloqueados en un protocolo DeFi o contrato inteligente. Estos activos pueden incluir criptomonedas, stablecoins y otros tokens.",yieldPoolSubtitle:"\xbfQu\xe9 es un pool de rendimiento?",yieldPoolDescription:"Los pools de rendimiento, o pools de liquidez, son fondos comunes aportados por los poseedores de tokens, que permiten negociar en exchanges descentralizados. Cuando contribuyes al pool, puedes ganar intereses de otras personas que tomen prestados esos fondos.",chooseSubtitle:"\xbfC\xf3mo deber\xedas elegir un pool? ",chooseDescription:"Cualquier decisi\xf3n financiera es una elecci\xf3n personal. Hemos agrupado algunos pools en distintos protocolos, pero cada pool tiene sus ventajas y sus riesgos. Hacemos todo lo posible por ofrecer informaci\xf3n \xfatil sobre cada pool, pero siempre es mejor que investigues m\xe1s si no est\xe1s seguro."},noPoolsTitle:"A\xfan no tienes inversiones",noPoolsDescription:"Descubre las inversiones disponibles, elige una que se ajuste a tus objetivos y saca el m\xe1ximo de tus criptomonedas.",errorTitle:"No se pueden cargar pools",errorDescription:"Ups, algo sali\xf3 mal al intentar cargar la informaci\xf3n del pool. Vuelve a intentarlo.",errorButton:"Int\xe9ntalo de nuevo"},poolCard:{onNetwork:"en {{networkName}}",rate:"Tasa (est.)",yieldRate:"Tasa de rendimiento (est.)",reward:"Recompensa",tvl:"TVL",exitPool:"Retirar",addToPool:"Depositar",apy:"{{apy}}% de APY",percentage:"{{percentage}}%",poweredBy:"Con tecnolog\xeda de {{providerName}}",deposited:"Suministrado",depositAndEarnings:"Dep\xf3sitos y ganancias",lockPeriod:"Per\xedodo de bloqueo",days:"{{days}} d\xedas",stake:"Staking"},poolFilters:{allPools:"Inversiones disponibles",myPools:"Mis Inversiones"},poolInfoScreen:{chainName:"Red: <0>{{networkName}}</0>",protocolName:"Protocolo: <0>{{providerName}}</0>",yieldRate:"Tasa de rendimiento",dailyYieldRate:"Tarifa diaria",ratePercent:"{{rate}}%",rewards:"Recompensas",noRewards:"Sin recompensas",safetyScore:"Puntuaci\xf3n de seguridad",tvl:"TVL",ageOfPool:"Antig\xfcedad de pool:",learnMoreOnProvider:"Ver pool en {{providerName}}",deposit:"Dep\xf3sito",depositAndEarnings:"Dep\xf3sitos y ganancias",withdraw:"Retirar",withdrawBottomSheet:{title:"Selecciona el tipo de retiro",withdrawAndClaim:"Retiro y reclamaci\xf3n",withdrawDescription:"Retirar una cantidad espec\xedfica de los tokens que hayas depositado en el pool",withdrawAndClaimRewardsDescription:"Retira una cantidad espec\xedfica de los tokens que hayas depositado en el pool y reclama tus recompensas autom\xe1ticamente",withdrawAndClaimEarningsDescription:"Retira una cantidad espec\xedfica de los tokens que hayas depositado en el pool y reclama tus ganancias autom\xe1ticamente",claimRewards:"Reclamar recompensas",claimRewardsDescription:"Reclama tus recompensas. No se pueden reclamar montos parciales de la recompensa",claimEarnings:"Reclamar ganancias",claimEarningsDescription:"Reclama las ganancias de tu dep\xf3sito. No se pueden reclamar montos parciales",exit:"Salir",exitDescription:"Al salir retirar\xe1s todo lo que tengas en el pool",exitWithRewardsDescription:"Al salir retirar\xe1s todo lo que tengas en el pool, incluidas las recompensas",exitWithEarningsDescription:"Al salir retirar\xe1s todo lo que tengas en el pool, incluidas las ganancias"},totalDepositAndEarnings:"Dep\xf3sito y ganancias totales",titleLocalAmountDisplay:"{{localCurrencySymbol}}{{localCurrencyAmount}}",lineItemAmountDisplay:"{{localCurrencySymbol}}{{localCurrencyAmount}} ({{cryptoAmount}} {{cryptoSymbol}})",infoBottomSheet:{gotIt:"Entendido",depositDescription:"Este es el desglose del monto depositado, los intereses que has ganado por ese monto y cualquier recompensa adicional que hayas recibido por participar en el pool.",depositNoBreakdownDescription:"Este n\xfamero combina tus tokens suministrados con cualquier inter\xe9s y recompensa que hayas ganado.\n\nAlgunos protocolos, como {{providerName}}, no proporcionan un desglose de tus ganancias: esto es normal. En su lugar, agregan tus ganancias directamente al monto depositado, que sigue ganando intereses en funci\xf3n del monto creciente. ",tvlTitle:"Valor total bloqueado (TVL)",tvlDescription:"TVL se refiere a al monto total de activos depositados en un pool de liquidez y se puede utilizar para ayudar a indicar la confianza y utilidad de un pool. Normalmente. un TVL mayor se correlaciona con el riesgo reducido, sin embargo ning\xfan pool est\xe1 completamente libre de riesgos.",ageTitle:"Antig\xfcedad de pool:",ageDescription:"Los pools de liquidez m\xe1s antiguos pueden indicar una trayectoria s\xf3lida y un historial de creaci\xf3n de confianza en la comunidad. Por ello, algunos pueden considerar que estos pools son m\xe1s seguros.\n\nNo hay una forma perfecta de determinar el riesgo, as\xed que usa esta informaci\xf3n como parte de tu investigaci\xf3n general para tomar la decisi\xf3n que m\xe1s te convenga.",yieldRateTitle:"Tasa de rendimiento",yieldRateDescription:"Aunque la mayor\xeda de los pools ofrecen ganancias en forma de token de pool de liquidez, algunos dan token(s) adicionales como recompensa o incentivo a\xf1adido.\n\nDado que {{appName}} agrega pools a trav\xe9s de m\xfaltiples protocolos, hemos combinado todas las tasas de ganancia y recompensa en una \xfanica tasa de rendimiento global para ayudarte a evaluar f\xe1cilmente tu potencial de ganancia. Esta cifra es estimada, ya que los valores de ganancia y recompensa fluct\xfaan constantemente.\n\nPara m\xe1s informaci\xf3n sobre los desgloses de ganancias puedes visitar <0>{{providerName}}</0>.",dailyYieldRateTitle:"Tarifa diaria",dailyYieldRateDescription:"La tarifa diaria mostrada refleja la tarifa diaria proporcionada por {{providerName}}.",dailyYieldRateLink:"Ver m\xe1s detalles de la tarifa diaria en {{providerName}}",safetyScoreTitle:"Puntuaci\xf3n de seguridad",safetyScoreDescription:"La Puntuaci\xf3n de seguridad desglosa la seguridad del activo b\xf3veda subyacente en varios factores clave. Su objetivo es llamar tu atenci\xf3n sobre los riesgos a considerar antes de invertir, e informarte sobre detalles t\xe9cnicos que quiz\xe1 no puedas evaluar t\xfa mismo.\nAunque la posici\xf3n completa siempre es m\xe1s complicada, la Puntuaci\xf3n de seguridad se brinda para simplificar las consideraciones clave sobre riesgos y seguridad y poner en marcha tu propia diligencia debida. Nuestro equipo considera con cuidado cada factor antes de desplegar una b\xf3veda, y vigila cada activo, cadena y protocolo que ha integrado {{providerName}}.",safetyScoreRateLink:"Ver m\xe1s detalles de la Puntuaci\xf3n de seguridad en {{providerName}}"},viewMoreDetails:"Ver m\xe1s detalles",viewLessDetails:"Ver menos detalles"},beforeDepositBottomSheet:{youNeedTitle:"Necesitas {{tokenSymbol}} en {{tokenNetwork}} para depositar",crossChainAlternativeDescription:"Si no quieres usar tus tokens en {{tokenNetwork}}, elige una opci\xf3n a continuaci\xf3n. Tendr\xe1s que volver para completar tu dep\xf3sito en el pool m\xe1s tarde.",beforeYouCanDepositTitle:"Antes de que puedas depositar...",beforeYouCanDepositDescription:"Tendr\xe1s que agregarr uno de los tokens del pool. Una vez agregado, tendr\xe1s que volver para completar el dep\xf3sito en el pool.",action:{swapAndDeposit:"Intercambiar y depositar",swapAndDepositDescription:"Elige cualquier token en {{tokenNetwork}}. Lo cambiaremos y lo depositaremos simult\xe1neamente por ti.",crossChainSwap:"Intercambio entre cadenas",crossChainSwapDescription:"Intercambia un token en otra red por {{tokenSymbol}}",swap:"Cambio",swapDescription:"Intercambia a {{tokenSymbol}} en {{tokenNetwork}} desde otro token de tu wallet",add:"Comprar",addDescription:"Compra {{tokenSymbol}} en {{tokenNetwork}} a uno de nuestros proveedores de confianza.",transfer:"Transferir",transferDescription:"Usa cualquier wallet o exchange compatible con {{tokenNetwork}} para depositar {{tokenSymbol}}."}},staking:{title:"Stake CCOP",subtitle:"Gana recompensas haciendo stake de tus tokens CCOP",poolTitle:"Pools de Staking",myStakes:"Mis Stakes",enterAmount:"Ingresa Cantidad",balance:"Balance del pool",network:"Red",enterAmountWithdraw:"Ingresa Cantidad a Retirar",connectToViewStakes:"Necesitas conectar tu wallet para ver tus stakes",amount:"Cantidad",duration:"Duraci\xf3n",days:"{{days}} d\xedas",apy:"Tasa de inter\xe9s m.v.",password:"Contrase\xf1a",stakeButton:"Hacer staking ahora",stakeSuccess:"Tokens stakeados exitosamente",stakeFailed:"Error al hacer stake de tokens",enterPassword:"Por favor ingresa tu contrase\xf1a",error:"Error",stakeDetails:"Detalles del Stake",startDate:"Fecha de Inicio",endDate:"Fecha de Finalizaci\xf3n",remainingDays:"D\xedas Restantes",status:"Estado",active:"Activo",completed:"Completado",withdraw:"Retirar",earlyWithdraw:"Retiro Anticipado",earlyWithdrawWarning:"El retiro anticipado tendr\xe1 una penalizaci\xf3n del 20%",penalty:"Penalizaci\xf3n",finalAmount:"Cantidad Final",confirmWithdraw:"Confirmar Retiro",confirmEarlyWithdraw:"Confirmar Retiro Anticipado",withdrawConfirmation:"\xbfEst\xe1s seguro que deseas retirar este stake?",success:"\xc9xito",successMessage:"Tu stake ha sido retirado exitosamente",earlyWithdrawTitle:"Confirmaci\xf3n de Retiro Anticipado",earlyWithdrawConfirmation:"Est\xe1s retirando {{amount}} CCOP antes del final del per\xedodo de staking ({{days}} d\xedas restantes). Se aplicar\xe1 una penalizaci\xf3n del 20% de {{penalty}} CCOP. Recibir\xe1s {{finalAmount}} CCOP. \xbfDeseas continuar?",connectRequired:"Se Requiere Conexi\xf3n de Wallet",connectToStake:"Necesitas conectar una wallet para hacer stake de tokens.",withdrawSuccess:"Retiro Exitoso",withdrawFailed:"Error en el Retiro",invalidAmount:"Por favor ingresa una cantidad v\xe1lida",insufficientBalance:"Balance insuficiente",invalidDuration:"Duraci\xf3n de staking inv\xe1lida",invalidStakeIndex:"\xcdndice de stake inv\xe1lido",stakeNotFound:"Stake no encontrado",alreadyClaimed:"Este stake ya ha sido reclamado"},wallet:{balance:"Balance"},myStakes:{stakeTitle:"Stake #{{index}}",amount:"Cantidad",startDate:"Fecha de Inicio",endDate:"Fecha de Finalizaci\xf3n",daysRemaining:"D\xedas Restantes",days:"d\xedas",claimed:"Reclamado",earlyWithdraw:"Retiro Anticipado",withdraw:"Retirar",loading:"Cargando tus stakes...",noStakes:"No tienes ning\xfan stake activo"}},global:{ok:"Aceptar",cancel:"Cancelar",confirm:"Confirmar",enterPassword:"Por favor ingresa tu contrase\xf1a",invalidPassword:"Contrase\xf1a inv\xe1lida"},addFundsActions:{add:"Comprar",transfer:"Transferir",swap:"Cambiar"},duratio