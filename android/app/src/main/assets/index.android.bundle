e1c tr\u01b0\u1eddng. B\u1ea1n c\xf3 th\u1ec3 d\xe1n to\xe0n b\u1ed9 tin nh\u1eafn."},bodySection2:{title:"Thi\u1ebfu m\u1ed9t s\u1ed1 ho\u1eb7c t\u1ea5t c\u1ea3 c\xe1c tin nh\u1eafn?",defaultContent:"N\u1ebfu g\u1eb7p s\u1ef1 c\u1ed1 khi nh\u1eadn tin nh\u1eafn, b\u1ea1n c\xf3 th\u1ec3 t\u1ea1m th\u1eddi b\u1ecf qua b\u01b0\u1edbc n\xe0y v\xe0 th\u1eed l\u1ea1i sau. \u0110\xf4i khi b\u1ea1n ph\u1ea3i \u0111\u1ee3i tin nh\u1eafn trong v\xe0i ph\xfat.",content:"$t(verificationInputHelpDialog.bodySection2.defaultContent)",content_countdown_0:"$t(verificationInputHelpDialog.bodySection2.defaultContent) T\xf9y ch\u1ecdn b\u1ecf qua b\xean d\u01b0\u1edbi s\u1ebd hi\u1ec3n th\u1ecb trong v\xf2ng {{count}} gi\xe2y."},body:"<0>$t(verificationInputHelpDialog.bodySection1.title)</0>\n\n$t(verificationInputHelpDialog.bodySection1.content)\n\n<1>$t(verificationInputHelpDialog.bodySection2.title)</1>\n\n$t(verificationInputHelpDialog.bodySection2.content)",skip:"T\u1ea1m th\u1eddi b\u1ecf qua",back:"Quay l\u1ea1i"},success:{message:"B\u1ea1n \u0111\xe3 ho\xe0n t\u1ea5t!"},verificationUnavailable:"T\xednh n\u0103ng k\u1ebft n\u1ed1i s\u1ed1 \u0111i\u1ec7n tho\u1ea1i hi\u1ec7n kh\xf4ng kh\u1ea3 d\u1ee5ng. Vui l\xf2ng nh\u1eadp s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n v\xe0 ch\xfang t\xf4i s\u1ebd th\xf4ng b\xe1o cho b\u1ea1n khi c\xf3 th\u1ec3 k\u1ebft n\u1ed1i l\u1ea1i. \n\nTrong th\u1eddi gian ch\u1edd \u0111\u1ee3i, b\u1ea1n c\xf3 th\u1ec3 ti\u1ebfp t\u1ee5c s\u1eed d\u1ee5ng {{appName}} qua m\xe3 QR ho\u1eb7c \u0110\u1ecba ch\u1ec9 t\xe0i kho\u1ea3n. \u0110\u1eebng lo, c\xe1c kho\u1ea3n thanh to\xe1n \u0111\u01b0\u1ee3c g\u1eedi \u0111\u1ebfn s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n s\u1ebd ch\u1edd \u0111\u1ebfn khi b\u1ea1n k\u1ebft n\u1ed1i s\u1ed1 \u0111\xf3 v\u1edbi t\xe0i kho\u1ea3n.",requests:"Y\xeau c\u1ea7u",empty:"B\u1ea1n kh\xf4ng c\xf3 Y\xeau c\u1ea7u thanh to\xe1n n\xe0o",celoDollarBalance:"S\u1ed1 d\u01b0 \u0110\xf4 la Celo",requestDeclined:"\u0110\xe3 t\u1eeb ch\u1ed1i y\xeau c\u1ea7u",requestPaid:"\u0110\xe3 thanh to\xe1n y\xeau c\u1ea7u",paymentRequestUpdateFailed:"Kh\xf4ng c\u1eadp nh\u1eadt \u0111\u01b0\u1ee3c y\xeau c\u1ea7u thanh to\xe1n",incomingPaymentRequestNotificationTitle:"{{name}} \u0111\xe3 y\xeau c\u1ea7u",outgoingPaymentRequestNotificationTitle:"\u0110ang ch\u1edd {{name}}",requesting:"\u0110ang y\xeau c\u1ea7u",request:"Y\xeau c\u1ea7u",requestToken:"Y\xeau c\u1ea7u {{token}}",requestSent:"\u0110\xe3 g\u1eedi y\xeau c\u1ea7u",from:"t\u1eeb",verificationMessage:"B\u1ea1n \u0111\xe3 thanh to\xe1n ph\xed \u0111\u1ec3 k\u1ebft n\u1ed1i t\xe0i kho\u1ea3n. Ch\xe0o m\u1eebng \u0111\u1ebfn v\u1edbi {{appName}}!",receivedAmountFromCelo:"B\u1ea1n \u0111\xe3 nh\u1eadn s\u1ed1 ti\u1ec1n n\xe0y t\u1eeb Faucet!",dollarsSent:"\u0110\xe3 g\u1eedi \u0110\xf4 la",withdrawToken:"R\xfat {{token}}",sendToken:"G\u1eedi {{token}}",payment:"Thanh to\xe1n",sendOrRequest:"G\u1eedi ho\u1eb7c y\xeau c\u1ea7u",recent:"G\u1ea7n \u0111\xe2y",contacts:"Danh b\u1ea1",characterLimitExceeded:"\u0110\xe3 v\u01b0\u1ee3t qu\xe1 gi\u1edbi h\u1ea1n {{max}} k\xfd t\u1ef1",payRequest:"Thanh to\xe1n y\xeau c\u1ea7u",sendTo:"G\u1eedi \u0111\u1ebfn",addDescription:"Th\xeam m\xf4 t\u1ea3",sentTo:"\u0110\xe3 g\u1eedi \u0111\u1ebfn",withdrawnTo:"\u0110\xe3 r\xfat v\xe0o",receivedFrom:"\u0110\xe3 nh\u1eadn t\u1eeb",commentLabel:"Tin nh\u1eafn",amountSent:"\u0110\xe3 g\u1eedi s\u1ed1 ti\u1ec1n",amountReceived:"S\u1ed1 ti\u1ec1n b\u1ea1n \u0111\xe3 nh\u1eadn \u0111\u01b0\u1ee3c",amountCeloWithdrawn:"S\u1ed1 ti\u1ec1n (CELO)",feeEducation:"Chu\u1ed7i kh\u1ed1i thu ph\xed giao d\u1ecbch \u0111\u1ec3 h\u1ed7 tr\u1ee3 c\xe1c m\u1ea1ng v\xe0 \u0111\u1ea3m b\u1ea3o m\u1ea1ng ho\u1ea1t \u0111\u1ed9ng th\xf4ng su\u1ed1t.",reviewPayment:"Xem l\u1ea1i thanh to\xe1n",requestPayment:"Y\xeau c\u1ea7u thanh to\xe1n",max:"T\u1ed0I \u0110A",inviteSendTo:"M\u1eddi v\xe0 g\u1eedi \u0111\u1ebfn",keepMoneySafe:"Ch\xfang t\xf4i s\u1ebd \u0111\u1ea3m b\u1ea3o an to\xe0n cho nh\u1eefng ti\u1ec1n n\xe0y \u0111\u1ebfn khi b\u1ea1n c\u1ee7a b\u1ea1n t\u1ea1o t\xe0i kho\u1ea3n {{appName}}",searchFriends:"Th\u1eed nh\u1eadp s\u1ed1 \u0111i\u1ec7n tho\u1ea1i n\u1ebfu b\u1ea1n kh\xf4ng t\xecm th\u1ea5y ng\u01b0\u1eddi m\xe0 m\xecnh \u0111ang t\xecm ki\u1ebfm",inviteVerifyPayment:"M\u1eddi v\xe0 x\xe1c nh\u1eadn thanh to\xe1n",noResultsFor:"Kh\xf4ng c\xf3 k\u1ebft qu\u1ea3 cho",noContacts:"Kh\xf4ng c\xf3 danh b\u1ea1",searchForSomeone:"T\xecm ki\u1ebfm ai \u0111\xf3 b\u1eb1ng \u0111\u1ecba ch\u1ec9 v\xed c\u1ee7a h\u1ecd",sentPayment:"Thanh to\xe1n \u0111\xe3 g\u1eedi",sentEscrowPayment:"Thanh to\xe1n \u1ee7y th\xe1c gi\u1eef \u0111\xe3 g\u1eedi",mobileNumber:"Di \u0111\u1ed9ng #",sendToMobileNumber:"S\u1ed1 \u0111i\u1ec7n tho\u1ea1i nh\u1eadn",requestFromMobileNumber:"S\u1ed1 \u0111i\u1ec7n tho\u1ea1i y\xeau c\u1ea7u",sendToAddress:"\u0110\u1ecba ch\u1ec9 nh\u1eadn",walletAddress:"\u0110\u1ecba ch\u1ec9 v\xed",inviteWithoutPayment:"Xin ch\xe0o! T\xf4i \u0111ang s\u1eed d\u1ee5ng {{appName}} \u0111\u1ec3 g\u1eedi ti\u1ec1n \u0111i\u1ec7n t\u1eed tr\xean to\xe0n th\u1ebf gi\u1edbi. \u1ee8ng d\u1ee5ng n\xe0y r\u1ea5t d\u1ec5 d\xf9ng n\xean t\xf4i mu\u1ed1n m\u1eddi b\u1ea1n d\xf9ng th\u1eed b\u1eb1ng \u0111\u01b0\u1eddng li\xean k\u1ebft sau: {{link}}",inviteWithEscrowedPayment:"Xin ch\xe0o! T\xf4i \u0111ang s\u1eed d\u1ee5ng {{appName}} \u0111\u1ec3 g\u1eedi ti\u1ec1n \u0111i\u1ec7n t\u1eed tr\xean to\xe0n th\u1ebf gi\u1edbi. T\xf4i v\u1eeba g\u1eedi cho b\u1ea1n {{amount}} {{token}}. Vui l\xf2ng t\u1ea3i xu\u1ed1ng \u1ee8ng d\u1ee5ng {{appName}} v\xe0 ch\u1ea5p nh\u1eadn {{token}} c\u1ee7a b\u1ea1n b\u1eb1ng \u0111\u01b0\u1eddng li\xean k\u1ebft sau: {{link}}",inviteWithRewards:"Xin ch\xe0o! \ud83d\udc4b T\xf4i \u0111ang s\u1eed d\u1ee5ng v\xed ti\u1ec1n \u0111i\u1ec7n t\u1eed {{appName}}. B\u1ea1n c\xf3 th\u1ec3 t\u1ea3i nhanh \u1ee9ng d\u1ee5ng n\xe0y xu\u1ed1ng v\xe0 k\u1ebft n\u1ed1i s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a m\xecnh, t\u1ea5t c\u1ea3 ch\xfang ta s\u1ebd c\xf9ng nh\u1eadn \u0111\u01b0\u1ee3c ti\u1ec1n th\u01b0\u1edfng d\u1ea1ng NFT phi\xean b\u1ea3n \u0111\u1eb7c bi\u1ec7t. \ud83d\udcab \n\nS\u1eed d\u1ee5ng \u0111\u01b0\u1eddng li\xean k\u1ebft n\xe0y \u0111\u1ec3 t\u1ea3i xu\u1ed1ng: {{link}}",inviteWithRewardsCUSD:"Ch\xe0o b\u1ea1n! Ch\xfang t\xf4i c\xf3 th\u1ec3 nh\u1eadn ngay 1 USDT ti\u1ec1n th\u01b0\u1edfng mi\u1ec5n ph\xed n\u1ebfu b\u1ea1n \u0111\u0103ng k\xfd {{appName}} v\xe0 k\u1ebft n\u1ed1i s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a m\xecnh. T\xf4i s\u1eed d\u1ee5ng v\xed n\xe0y \u0111\u1ec3 t\u0103ng kho\u1ea3n ti\u1ebft ki\u1ec7m b\u1eb1ng USD v\xe0 ti\u1ec1n \u0111i\u1ec7n t\u1eed c\u1ee7a m\xecnh v\xe0 b\u1ea1n c\xf3 th\u1ec3 d\u1ec5 d\xe0ng t\u1ea1o v\xed trong v\xe0i gi\xe2y ch\u1ec9 b\u1eb1ng s\u1ed1 \u0111i\u1ec7n tho\u1ea1i. H\xe3y \u0111\u0103ng k\xfd b\u1eb1ng \u0111\u01b0\u1eddng li\xean k\u1ebft gi\u1edbi thi\u1ec7u c\u1ee7a t\xf4i t\u1ea1i \u0111\xe2y nh\xe9: \n\n{{link}} \n\n H\xe3y nhanh tay, ch\u01b0\u01a1ng tr\xecnh khuy\u1ebfn m\xe3i gi\u1edbi thi\u1ec7u s\u1ebd s\u1edbm k\u1ebft th\xfac.",loadingContacts:"\u0110ang t\xecm danh b\u1ea1 c\u1ee7a b\u1ea1n",myCode:"M\xe3 c\u1ee7a t\xf4i",scanCode:"Qu\xe9t",scanQRCode:"Qu\xe9t m\xe3 QR",enterQRCode:"Nh\u1eadp m\xe3 QR",writeStorageNeededForQrDownload:"B\u1ea1n c\u1ea7n c\u1ea5p quy\u1ec1n ghi v\xe0o b\u1ed9 nh\u1edb \u0111\u1ec3 t\u1ea3i xu\u1ed1ng m\xe3 QR",cameraScanInfo:"\u0110\u01b0a m\xe3 v\xe0o gi\u1eefa h\u1ed9p b\xean tr\xean",cameraNotAuthorizedTitle:"B\u1eadt camera",cameraNotAuthorizedDescription:"Vui l\xf2ng b\u1eadt Camera trong ph\u1ea7n C\xe0i \u0111\u1eb7t c\u1ee7a \u0111i\u1ec7n tho\u1ea1i. B\u1ea1n c\u1ea7n quy\u1ec1n n\xe0y \u0111\u1ec3 qu\xe9t m\xe3 QR.",cameraSettings:"C\xe0i \u0111\u1eb7t",toSentOrRequestPayment:"\u0111\u1ec3 g\u1eedi ho\u1eb7c y\xeau c\u1ea7u thanh to\xe1n",reminderSent:"\u0110\xe3 g\u1eedi l\u1eddi nh\u1eafc",reclaimPayment:"Nh\u1eadn l\u1ea1i kho\u1ea3n thanh to\xe1n",totalRefunded:"\u0110\xe3 ho\xe0n tr\u1ea3 to\xe0n b\u1ed9",loadingVerificationStatus:"\u0110ang ki\u1ec3m tra xem ng\u01b0\u1eddi nh\u1eadn \u0111\xe3 k\u1ebft n\u1ed1i ch\u01b0a\u2026",askForContactsPermissionAction:"L\u1ea5y Danh b\u1ea1 c\u1ee7a t\xf4i",newAccountBalance:"S\u1ed1 d\u01b0 m\u1edbi trong t\xe0i kho\u1ea3n: ",estimatingFee:"\u0110ang \u01b0\u1edbc t\xednh ph\xed ",estimatedFee:"Ph\xed \u01b0\u1edbc t\xednh: ",selectBalance:"Ch\u1ecdn s\u1ed1 d\u01b0",stableBalance:"S\u1ed1 d\u01b0 {{token}}",selectToken:"Ch\u1ecdn t\xe0i s\u1ea3n",verificationCta:{header:"G\u1eedi ti\u1ec1n \u0111i\u1ec7n t\u1eed nh\u01b0 g\u1eedi tin nh\u1eafn v\u0103n b\u1ea3n!",body:"Li\xean k\u1ebft s\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n v\u1edbi \u0111\u1ecba ch\u1ec9 v\xed c\u1ee7a b\u1ea1n \u0111\u1ec3 b\u1ea1n c\xf3 th\u1ec3 g\u1eedi v\xe0 nh\u1eadn thanh to\xe1n v\u1edbi b\u1ea1n b\xe8.",cta:"K\u1ebft n\u1ed1i s\u1ed1 \u0111i\u1ec7n tho\u1ea1i"},importContactsCta:{header:"B\u1eadt quy\u1ec1n truy c\u1eadp danh b\u1ea1",body:"Vui l\xf2ng b\u1eadt Danh b\u1ea1 trong ph\u1ea7n C\xe0i \u0111\u1eb7t c\u1ee7a \u0111i\u1ec7n tho\u1ea1i \u0111\u1ec3 t\xecm b\u1ea1n b\xe8 theo t\xean.",cta:"C\xe0i \u0111\u1eb7t"},contactSyncProgress:{header:"\u0110ang \u0111\u1ed3ng b\u1ed9 danh b\u1ea1",progress:"{{current}}/{{total}}",importing:"\u0110ang nh\u1eadp..."},confirmAccount:{header:"{{displayName}} c\xf3 nhi\u1ec1u v\xed.",headerNoDisplayName:"S\u1ed1 \u0111i\u1ec7n tho\u1ea1i n\xe0y c\xf3 nhi\u1ec1u v\xed.",button:"X\xe1c nh\u1eadn \u0111\u1ecba ch\u1ec9 v\xed"},secureSendExplanation:{body1:"C\xf3 nhi\u1ec1u v\xed \u0111\u01b0\u1ee3c li\xean k\u1ebft v\u1edbi {{e164PhoneNumber}}. \u0110\u1ec3 x\xe1c nh\u1eadn b\u1ea1n d\xf9ng \u0111\xfang t\xe0i kho\u1ea3n, vui l\xf2ng qu\xe9t m\xe3 QR ho\u1eb7c nh\u1eadp \u0111\u1ecba ch\u1ec9 v\xed c\u1ee7a h\u1ecd.",body2:"B\u1ea1n ph\u1ea3i qu\xe9t m\xe3 QR c\u1ee7a h\u1ecd ho\u1eb7c x\xe1c nh\u1eadn \u0110\u1ecba ch\u1ec9 t\xe0i kho\u1ea3n c\u1ee7a h\u1ecd tr\u01b0\u1edbc khi giao d\u1ecbch."},confirmAccountNumber:{title:"X\xe1c nh\u1eadn \u0111\u1ecba ch\u1ec9 v\xed",bodyPartial:"H\xe3y y\xeau c\u1ea7u {{displayName}} cung c\u1ea5p b\u1ed1n ch\u1eef s\u1ed1 cu\u1ed1i trong \u0111\u1ecba ch\u1ec9 v\xed c\u1ee7a h\u1ecd. C\xe1ch h\u1ecfi an to\xe0n nh\u1ea5t l\xe0 h\u1ecfi tr\u1ef1c ti\u1ebfp ho\u1eb7c qua \u0111i\u1ec7n tho\u1ea1i.",bodyPartialNoDisplayName:"H\xe3y y\xeau c\u1ea7u ng\u01b0\u1eddi li\xean h\u1ec7 cung c\u1ea5p b\u1ed1n ch\u1eef s\u1ed1 cu\u1ed1i trong \u0111\u1ecba ch\u1ec9 v\xed c\u1ee7a h\u1ecd. C\xe1ch h\u1ecfi an to\xe0n nh\u1ea5t l\xe0 h\u1ecfi tr\u1ef1c ti\u1ebfp ho\u1eb7c qua \u0111i\u1ec7n tho\u1ea1i.",body1Full:"H\xe3y y\xeau c\u1ea7u {{displayName}} cung c\u1ea5p \u0110\u1ecba ch\u1ec9 v\xed c\u1ee7a h\u1ecd.",body1FullNoDisplayName:"H\xe3y y\xeau c\u1ea7u ng\u01b0\u1eddi li\xean h\u1ec7 cung c\u1ea5p \u0110\u1ecba ch\u1ec9 v\xed c\u1ee7a h\u1ecd.",body2Full:"C\xe1ch h\u1ecfi an to\xe0n nh\u1ea5t l\xe0 h\u1ecfi tr\u1ef1c ti\u1ebfp. V\xec l\xfd do b\u1ea3o m\u1eadt, vui l\xf2ng kh\xf4ng d\xf9ng tin nh\u1eafn v\u0103n b\u1ea3n (SMS).",help:"T\xf4i c\xf3 th\u1ec3 t\xecm \u0110\u1ecba ch\u1ec9 v\xed \u1edf \u0111\xe2u?",submit:"G\u1eedi"},accountInputHeaderPartial:"4 ch\u1eef s\u1ed1 cu\u1ed1i",accountInputHeaderFull:"\u0110\u1ecba ch\u1ec9 t\xe0i kho\u1ea3n",helpModal:{header:"\u0110ang t\xecm \u0111\u1ecba ch\u1ec9 v\xed",body1:"\u0110\u1ecba ch\u1ec9 v\xed c\u1ee7a b\u1ea1n n\u1eb1m trong menu. H\xe3y m\u1edf menu b\u1eb1ng c\xe1ch nh\u1ea5n v\xe0o bi\u1ec3u t\u01b0\u1ee3ng menu \u1edf g\xf3c tr\xe1i c\xf9ng b\xean tr\xe1i.",body2:"\u0110\u1ecba ch\u1ec9 v\xed c\u1ee7a b\u1ea1n n\u1eb1m g\u1ea7n ph\u1ea7n d\u01b0\u1edbi c\xf9ng c\u1ee7a menu.",body3:"\u0110\u1ecba ch\u1ec9 v\xed b\u1eaft \u0111\u1ea7u b\u1eb1ng \"0x\" v\xe0 c\xf3 42 k\xfd t\u1ef1"},transferAddressChanged:"Ng\u01b0\u1eddi li\xean h\u1ec7 n\xe0y \u0111\xe3 thay \u0111\u1ed5i \u0110\u1ecba ch\u1ec9 t\xe0i kho\u1ea3n sau giao d\u1ecbch. Kho\u1ea3n thanh to\xe1n n\xe0y \u0111\xe3 \u0111\u01b0\u1ee3c g\u1eedi \u0111\u1ebfn:",addressConfirmed:"\u0110\xe3 x\xe1c nh\u1eadn \u0110\u1ecba ch\u1ec9 t\xe0i kho\u1ea3n",sending:"\u0110ang g\u1eedi",feeActual:"Ph\xed",feeEstimate:"Ph\xed \u01b0\u1edbc t\xednh",encryption:{warningLabel:"Ghi ch\xfa n\xe0y s\u1ebd kh\xf4ng \u0111\u01b0\u1ee3c m\xe3 h\xf3a",warningModalHeader:"Th\xf4ng tin v\u1ec1 quy tr\xecnh m\xe3 h\xf3a",warningModalBody:"Quy tr\xecnh m\xe3 h\xf3a s\u1ebd \u0111\u1ea3m b\u1ea3o ri\xeang t\u01b0 cho ghi ch\xfa c\u1ee7a b\u1ea1n. {{appName}} s\u1eed d\u1ee5ng c\xf4ng ngh\u1ec7 m\xe3 h\xf3a cho ghi ch\xfa v\u1ec1 giao d\u1ecbch khi c\u1ea3 ng\u01b0\u1eddi g\u1eedi v\xe0 ng\u01b0\u1eddi nh\u1eadn thi\u1ebft l\u1eadp t\xednh n\u0103ng n\xe0y. Qu\xe1 tr\xecnh thi\u1ebft l\u1eadp th\u01b0\u1eddng di\u1ec5n ra t\u1ef1 \u0111\u1ed9ng sau khi ng\u01b0\u1eddi d\xf9ng g\u1eedi giao d\u1ecbch \u0111\u1ea7u ti\xean.",feeLabel:"Ph\xed m\xe3 h\xf3a thu m\u1ed9t l\u1ea7n",feeModalHeader:"Ph\xed m\xe3 h\xf3a thu m\u1ed9t l\u1ea7n",feeModalBody:"Quy tr\xecnh m\xe3 h\xf3a gi\xfap \u0111\u1ea3m b\u1ea3o s\u1ef1 ri\xeang t\u01b0 cho d\u1eef li\u1ec7u nh\u1ea1y c\u1ea3m. Giao d\u1ecbch \u0111\u1ea7u ti\xean c\u1ee7a b\u1ea1n s\u1ebd c\xf3 th\xeam kho\u1ea3n ph\xed nh\u1ecf thu m\u1ed9t l\u1ea7n \u0111\u1ec3 thi\u1ebft l\u1eadp quy tr\xecnh m\xe3 h\xf3a. Nh\u1edd v\u1eady, ghi ch\xfa c\u1ee7a b\u1ea1n s\u1ebd \u0111\u01b0\u1ee3c g\u1eedi an to\xe0n v\xe0 ri\xeang t\u01b0."},sendToAddressWarning:{title:"\u0110ang g\u1eedi \u0111\u1ebfn m\u1ed9t \u0111\u1ecba ch\u1ec9",body:"Vui l\xf2ng \u0111\u1ea3m b\u1ea3o \u0111\u1ecba ch\u1ec9 n\xe0y h\u1ed7 tr\u1ee3 t\xe0i s\u1ea3n b\u1ea1n \u0111ang mu\u1ed1n g\u1eedi. Ti\u1ec1n c\u1ee7a b\u1ea1n c\xf3 th\u1ec3 s\u1ebd kh\xf4ng thu h\u1ed3i \u0111\u01b0\u1ee3c n\u1ebfu \u0111\u1ecba ch\u1ec9 n\xe0y kh\xf4ng h\u1ee3p l\u1ec7. Tr\u01b0\u1edbc ti\xean, h\xe3y g\u1eedi th\u1eed m\