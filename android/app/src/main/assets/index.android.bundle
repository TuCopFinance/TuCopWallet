\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0438\u0439 \u0432 {{appName}}. \u041d\u0430\u0442\u043e\u043c\u0456\u0441\u0442\u044c \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u044f \u0430\u0431\u043e \u043f\u043b\u0430\u0442\u0456\u0436 \u0437\u0430 \u0430\u0434\u0440\u0435\u0441\u043e\u044e \u0433\u0430\u043c\u0430\u043d\u0446\u044f, \u044f\u043a\u0449\u043e \u0432\u043e\u043d\u0430 \u0432\u0430\u043c \u0432\u0456\u0434\u043e\u043c\u0430. \n\n \u041f\u0456\u0441\u043b\u044f \u0442\u043e\u0433\u043e \u044f\u043a \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u044c \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a {{appName}}, \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0454 \u0441\u0432\u0456\u0439 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443, \u0432\u043d\u0435\u0441\u0435 \u043a\u043e\u0448\u0442\u0438 \u0442\u0430 \u0437\u0431\u0435\u0440\u0435\u0436\u0435 \u0457\u0445 \u0443 \u0433\u0430\u043c\u0430\u043d\u0446\u0456 \u043f\u0440\u043e\u0442\u044f\u0433\u043e\u043c 7 \u0434\u043d\u0456\u0432, \u043a\u043e\u0436\u0435\u043d \u0456\u0437 \u0432\u0430\u0441 \u043e\u0442\u0440\u0438\u043c\u0430\u0454 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0443 0,50 cUSD \u0437\u0430 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043d\u043d\u044f \u043a\u043e\u0448\u0442\u0456\u0432."}},celoNews:{headerTitle:"\u041e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",headerDescription:"\u0414\u0456\u0437\u043d\u0430\u0439\u0442\u0435\u0441\u044f \u043f\u0440\u043e \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f, \u043f\u0456\u043b\u043e\u0442\u043d\u0456 \u043f\u0440\u043e\u0454\u043a\u0442\u0438 \u0442\u0430 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0456 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0432 \u0431\u043b\u043e\u0437\u0456 \u043f\u0440\u043e Celo.",readMoreButtonText:"\u0414\u0435\u0442\u0430\u043b\u044c\u043d\u0456\u0448\u0435 \u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0432 \u0431\u043b\u043e\u0437\u0456",loadingError:"\u041d\u0430 \u0436\u0430\u043b\u044c, \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u043e\u0441\u0442\u0430\u043d\u043d\u0456 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437 \u043f\u0456\u0437\u043d\u0456\u0448\u0435.",retryButtonText:"\u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0438"},chooseYourAdventure:{header:"\u041b\u0430\u0441\u043a\u0430\u0432\u043e \u043f\u0440\u043e\u0441\u0438\u043c\u043e \u0434\u043e {{appName}}",subtitle:"\u042f\u043a\u043e\u044e \u0431\u0443\u0434\u0435 \u0432\u0430\u0448\u0430 \u043f\u0435\u0440\u0448\u0430 \u0434\u0456\u044f?",later:"\u0412\u0456\u0434\u043a\u043b\u0430\u0434\u0443 \u043d\u0430 \u043f\u043e\u0442\u0456\u043c",options:{add:"\u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u043a\u043e\u0448\u0442\u0438 \u0434\u043e \u0441\u0432\u043e\u0433\u043e \u0433\u0430\u043c\u0430\u043d\u0446\u044f",dapp:"\u0414\u0456\u0437\u043d\u0430\u0439\u0442\u0435\u0441\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043a\u0440\u0438\u043f\u0442\u043e\u0432\u0430\u043b\u044e\u0442\u0438",earn:"\u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u0439\u0442\u0435 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456 \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443",profile:"\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0444\u0456\u043b\u044c",learn:"\u0414\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f \u043f\u0440\u043e Celo",learnPoints:"\u0414\u0456\u0437\u043d\u0430\u0439\u0442\u0435\u0441\u044f \u0431\u0456\u043b\u044c\u0448\u0435 \u043f\u0440\u043e \u0431\u0430\u043b\u0438 {{appName}}"}},reverifyUsingCPVHomecard:{description:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0441\u0432\u0456\u0439 \u043d\u043e\u043c\u0435\u0440, \u0449\u043e\u0431 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438, \u043e\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u0439 \u0437\u0434\u043e\u0431\u0443\u0432\u0430\u0442\u0438 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438 \u043d\u0430 \u0441\u0432\u0456\u0439 \u043a\u0440\u0438\u043f\u0442\u043e\u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c",buttonLabel:"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043f\u0456\u0434\u2019\u0454\u0434\u043d\u0430\u0442\u0438 \u043d\u043e\u043c\u0435\u0440"},profileScreen:{generateName:"\u0417\u0433\u0435\u043d\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0456\u043c'\u044f",namePlaceholder:"\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u0456\u043c\u2019\u044f, \u043d\u0430\u043f\u0440. \xab{{exampleName}}\xbb",profilePictureDisclaimer:"\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0444\u043e\u0442\u043e \u043f\u0440\u043e\u0444\u0456\u043b\u044e \u0443 {{appName}}. \u0412\u0430\u0448\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u044c\u0441\u044f \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0438\u043c, \u0430\u0434\u0436\u0435 \u0432\u043e\u043d\u043e \u043d\u0435 \u043f\u043e\u0448\u0438\u0440\u044e\u0454\u0442\u044c\u0441\u044f \u0456 \u043d\u0435 \u043f\u0435\u0440\u0435\u0434\u0430\u0454\u0442\u044c\u0441\u044f."},tokenBottomSheet:{searchAssets:"\u041f\u043e\u0448\u0443\u043a \u0430\u043a\u0442\u0438\u0432\u0456\u0432",noTokenInResult:"\u041d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e \u0436\u043e\u0434\u043d\u0438\u0445 \u0437\u0431\u0456\u0433\u0456\u0432 \u0456\u0437 <0>\"{{searchTerm}}\"</0>",noFilterSearchResults:"\u041d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e \u0430\u043a\u0442\u0438\u0432\u0456\u0432, \u044f\u043a\u0456 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u044e\u0442\u044c \u0437\u0430\u043f\u0438\u0442\u0443 \xab{{searchTerm}}\xbb \u0443 \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0456\u044f\u0445: {{filterNames}}",noFilterResults:"\u041d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e \u0430\u043a\u0442\u0438\u0432\u0456\u0432, \u044f\u043a\u0456 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u044e\u0442\u044c \u0442\u0430\u043a\u0438\u043c \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0456\u044f\u043c: {{filterNames}}",noSearchResults:"\u041d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e \u0430\u043a\u0442\u0438\u0432\u0456\u0432, \u044f\u043a\u0456 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u044e\u0442\u044c \u0437\u0430\u043f\u0438\u0442\u0443 \xab{{searchTerm}}\xbb",filters:{myTokens:"\u041c\u043e\u0457 \u0442\u043e\u043a\u0435\u043d\u0438",popular:"\u041f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u0456",recentlySwapped:"\u041d\u0435\u0434\u0430\u0432\u043d\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0456 \u0443 \u0441\u0432\u043e\u043f\u0456",network:"\u041c\u0435\u0440\u0435\u0436\u0430: {{networkName}}",selectNetwork:"\u041c\u0435\u0440\u0435\u0436\u0430",stablecoins:"\u0421\u0442\u0435\u0439\u0431\u043b\u043a\u043e\u0457\u043d\u0430\u0445",gasTokens:"\u0422\u043e\u043a\u0435\u043d\u0438 \u0434\u043b\u044f \u0433\u0430\u0437\u0443",tokens:"\u0422\u043e\u043a\u0435\u043d"}},homeActions:{add:"\u041a\u0443\u043f\u0438\u0442\u0438",receive:"\u041e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f",request:"\u0417\u0430\u043f\u0438\u0442",send:"\u041d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438",swap:"\u041e\u0431\u043c\u0456\u043d\u044f\u0442\u0438",withdraw:"\u0417\u043d