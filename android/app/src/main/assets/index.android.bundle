u043b, \u0456 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438",withdrawAndClaimEarningsDescription:"\u0412\u0438\u0432\u0435\u0441\u0442\u0438 \u043f\u0435\u0432\u043d\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0442\u043e\u043a\u0435\u043d\u0456\u0432, \u044f\u043a\u0456 \u0432\u0438 \u0432\u043d\u0435\u0441\u043b\u0438 \u0432 \u043f\u0443\u043b, \u0456 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u0438",claimRewards:"\u0417\u0430\u043f\u0438\u0442 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438",claimRewardsDescription:"\u041e\u0442\u0440\u0438\u043c\u0430\u0439\u0442\u0435 \u0441\u0432\u043e\u0457 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438. \u0427\u0430\u0441\u0442\u043a\u043e\u0432\u0456 \u0441\u0443\u043c\u0438 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438 \u043d\u0435 \u043f\u0456\u0434\u043b\u044f\u0433\u0430\u044e\u0442\u044c \u0432\u0438\u043f\u043b\u0430\u0442\u0456",claimEarnings:"\u041e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u0443",claimEarningsDescription:"\u041e\u0442\u0440\u0438\u043c\u0430\u0439\u0442\u0435 \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u0438 \u0437 \u0432\u0430\u0448\u043e\u0433\u043e \u0434\u0435\u043f\u043e\u0437\u0438\u0442\u0443. \u0427\u0430\u0441\u0442\u043a\u043e\u0432\u0456 \u0441\u0443\u043c\u0438 \u043d\u0435 \u043f\u0456\u0434\u043b\u044f\u0433\u0430\u044e\u0442\u044c \u0432\u0438\u043f\u043b\u0430\u0442\u0456",exit:"\u0412\u0438\u0439\u0442\u0438",exitDescription:"\u041f\u0440\u0438 \u0432\u0438\u0445\u043e\u0434\u0456 \u0431\u0443\u0434\u0435 \u0432\u0438\u0432\u0435\u0434\u0435\u043d\u043e \u0432\u0441\u0435, \u0449\u043e \u0443 \u0432\u0430\u0441 \u0454 \u0432 \u043f\u0443\u043b\u0456",exitWithRewardsDescription:"\u041f\u0440\u0438 \u0432\u0438\u0445\u043e\u0434\u0456 \u0431\u0443\u0434\u0435 \u0432\u0438\u0432\u0435\u0434\u0435\u043d\u043e \u0432\u0441\u0435, \u0449\u043e \u0443 \u0432\u0430\u0441 \u0454 \u0432 \u043f\u0443\u043b\u0456, \u0432\u043a\u043b\u044e\u0447\u043d\u043e \u0437 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0430\u043c\u0438",exitWithEarningsDescription:"\u041f\u0440\u0438 \u0432\u0438\u0445\u043e\u0434\u0456 \u0431\u0443\u0434\u0435 \u0432\u0438\u0432\u0435\u0434\u0435\u043d\u043e \u0432\u0441\u0435, \u0449\u043e \u0443 \u0432\u0430\u0441 \u0454 \u0432 \u043f\u0443\u043b\u0456, \u0432\u043a\u043b\u044e\u0447\u043d\u043e \u0437 \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u0430\u043c\u0438"},totalDepositAndEarnings:"\u0417\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0439 \u043e\u0431\u0441\u044f\u0433 \u0432\u043a\u043b\u0430\u0434\u0456\u0432 \u0442\u0430 \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u0456\u0432",titleLocalAmountDisplay:"{{localCurrencySymbol}}{{localCurrencyAmount}}",lineItemAmountDisplay:"{{localCurrencySymbol}}{{localCurrencyAmount}} ({{cryptoAmount}} {{cryptoSymbol}})",infoBottomSheet:{gotIt:"\u0417\u0440\u043e\u0437\u0443\u043c\u0456\u043b\u043e",depositDescription:"\u0426\u0435 \u0440\u043e\u0437\u043f\u043e\u0434\u0456\u043b \u0432\u0430\u0448\u043e\u0457 \u0441\u0443\u043c\u0438 \u0432\u043d\u0435\u0441\u043a\u0456\u0432, \u0432\u0456\u0434\u0441\u043e\u0442\u043a\u0456\u0432, \u044f\u043a\u0456 \u0432\u0438 \u0437\u0430\u0440\u043e\u0431\u0438\u043b\u0438 \u043d\u0430 \u0446\u044e \u0441\u0443\u043c\u0443, \u0442\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0438\u0445 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434, \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u0438\u0445 \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u043f\u0443\u043b\u0456.",depositNoBreakdownDescription:"\u0426\u044f \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043f\u043e\u0454\u0434\u043d\u0443\u0454 \u043d\u0430\u0434\u0430\u043d\u0456 \u0442\u043e\u043a\u0435\u043d\u0438 \u0437 \u0443\u0441\u0456\u043c\u0430 \u0432\u0456\u0434\u0441\u043e\u0442\u043a\u0430\u043c\u0438 \u0442\u0430 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0430\u043c\u0438, \u044f\u043a\u0456 \u0432\u0438 \u0437\u0430\u0440\u043e\u0431\u0438\u043b\u0438.\n\n\u0414\u0435\u044f\u043a\u0456 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0438, \u044f\u043a-\u043e\u0442 {{providerName}}, \u043d\u0435 \u043d\u0430\u0434\u0430\u044e\u0442\u044c \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u043e\u0437\u043f\u043e\u0434\u0456\u043b\u0443 \u0432\u0430\u0448\u043e\u0433\u043e \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443 \u2014 \u0446\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e. \u041d\u0430\u0442\u043e\u043c\u0456\u0441\u0442\u044c \u0432\u043e\u043d\u0438 \u0434\u043e\u0434\u0430\u044e\u0442\u044c \u0432\u0430\u0448\u0456 \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u0438 \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0434\u043e \u0441\u0443\u043c\u0438 \u0432\u043d\u0435\u0441\u043a\u0456\u0432, \u043d\u0430 \u044f\u043a\u0443 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u044e\u0442\u044c \u043d\u0430\u0440\u0430\u0445\u043e\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u0432\u0456\u0434\u0441\u043e\u0442\u043a\u0438 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u0437\u0440\u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0457 \u0441\u0443\u043c\u0438. ",tvlTitle:"\u0417\u0430\u0433\u0430\u043b\u044c\u043d\u0430 \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0430 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044c (TVL)",tvlDescription:"TVL \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0443\u0454 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0443 \u0441\u0443\u043c\u0443 \u0430\u043a\u0442\u0438\u0432\u0456\u0432, \u0432\u043d\u0435\u0441\u0435\u043d\u0438\u0445 \u0443 \u043f\u0443\u043b \u043b\u0456\u043a\u0432\u0456\u0434\u043d\u043e\u0441\u0442\u0456, \u0456 \u043c\u043e\u0436\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u0434\u043b\u044f \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043d\u0430\u0434\u0456\u0439\u043d\u043e\u0441\u0442\u0456 \u0442\u0430 \u043a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456 \u043f\u0443\u043b\u0443. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0432\u0438\u0449\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a TVL \u0441\u0432\u0456\u0434\u0447\u0438\u0442\u044c \u043f\u0440\u043e \u0437\u043d\u0438\u0436\u0435\u043d\u043d\u044f \u0440\u0438\u0437\u0438\u043a\u0443, \u043f\u0440\u043e\u0442\u0435 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0431\u0435\u0437\u0440\u0438\u0437\u0438\u043a\u043e\u0432\u0438\u0445 \u043f\u0443\u043b\u0456\u0432 \u043d\u0435\u043c\u0430\u0454.",ageTitle:"\u0412\u0456\u043a \u043f\u0443\u043b\u0443",ageDescription:"\u0421\u0442\u0430\u0440\u0456\u0448\u0456 \u043f\u0443\u043b\u0438 \u043b\u0456\u043a\u0432\u0456\u0434\u043d\u043e\u0441\u0442\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0441\u0432\u0456\u0434\u0447\u0438\u0442\u0438 \u043f\u0440\u043e \u043d\u0430\u0434\u0456\u0439\u043d\u0443 \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u0442\u0430 \u043d\u0430\u0431\u0443\u0442\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c \u0434\u043e\u0432\u0456\u0440\u0438 \u0432 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456. \u0427\u0435\u0440\u0435\u0437 \u0446\u0435 \u0434\u0435\u044f\u043a\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0442\u0430\u043a\u0456 \u043f\u0443\u043b\u0438 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u0456\u0448\u0438\u043c\u0438.\n\n\u041d\u0435\u043c\u0430\u0454 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u0443 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0440\u0438\u0437\u0438\u043a\u0443, \u0442\u043e\u043c\u0443 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0446\u044e \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u044f\u043a \u0447\u0430\u0441\u0442\u0438\u043d\u0443 \u0441\u0432\u043e\u0433\u043e \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0443\u0445\u0432\u0430\u043b\u0438\u0442\u0438 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0440\u0456\u0448\u0435\u043d\u043d\u044f.",yieldRateTitle:"\u0421\u0442\u0430\u0432\u043a\u0430 \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u043e\u0432\u043e\u0441\u0442\u0456",yieldRateDescription:"\u0422\u043e\u0434\u0456 \u044f\u043a \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u043f\u0443\u043b\u0456\u0432 \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u044e\u0442\u044c \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043e\u043a \u0443 \u0432\u0438\u0433\u043b\u044f\u0434\u0456 \u0442\u043e\u043a\u0435\u043d\u0456\u0432 \u043f\u0443\u043b\u0443 \u043b\u0456\u043a\u0432\u0456\u0434\u043d\u043e\u0441\u0442\u0456, \u0434\u0435\u044f\u043a\u0456 \u0437 \u043d\u0438\u0445 \u043d\u0430\u0434\u0430\u044e\u0442\u044c \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u0442\u043e\u043a\u0435\u043d\u0438 \u044f\u043a \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0443 \u0430\u0431\u043e \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0438\u0439 \u0441\u0442\u0438\u043c\u0443\u043b.\n\n\u041e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 {{appName}} \u043e\u0431\u2019\u0454\u0434\u043d\u0443\u0454 \u043f\u0443\u043b\u0438 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0456\u0432, \u043c\u0438 \u043e\u0431\u2019\u0454\u0434\u043d\u0430\u043b\u0438 \u0432\u0441\u0456 \u0441\u0442\u0430\u0432\u043a\u0438 \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443 \u0442\u0430 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438 \u0432 \u0454\u0434\u0438\u043d\u0443 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0443 \u0441\u0442\u0430\u0432\u043a\u0443 \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u043e\u0432\u043e\u0441\u0442\u0456, \u0449\u043e\u0431 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0430\u043c \u043b\u0435\u0433\u043a\u043e \u043e\u0446\u0456\u043d\u0438\u0442\u0438 \u0432\u0430\u0448 \u043f\u043e\u0442\u0435\u043d\u0446\u0456\u0430\u043b \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443. \u0426\u044f \u0446\u0438\u0444\u0440\u0430 \u0454 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e\u044e, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0430 \u043f\u0440\u0438\u0431\u0443\u0442\u043a\u0443 \u0442\u0430 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434 \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u043e \u043a\u043e\u043b\u0438\u0432\u0430\u0454\u0442\u044c\u0441\u044f.\n\n\u0414\u043b\u044f \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u043e\u0457 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457 \u043f\u0440\u043e \u0440\u043e\u0437\u043f\u043e\u0434\u0456\u043b \u0437\u0430\u0440\u043e\u0431\u0456\u0442\u043a\u0443 \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u0439\u0442\u0435 <0>{{providerName}}</0>.",dailyYieldRateTitle:"\u0414\u0435\u043d\u043d\u0430 \u0441\u0442\u0430\u0432\u043a\u0430",dailyYieldRateDescription:"\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0430 \u0434\u0435\u043d\u043d\u0430 \u0441\u0442\u0430\u0432\u043a\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 \u0434\u0435\u043d\u043d\u0456\u0439 \u0441\u0442\u0430\u0432\u0446\u0456, \u04