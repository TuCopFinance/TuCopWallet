xed by [Nadav Magier](https://github.com/Nadav0077).","reported_by":null,"title":"ws: Memory exhaustion DoS from tiny fragments and data chunks","metadata":null,"cves":["CVE-2026-48779"],"access":"public","severity":"high","module_name":"ws","vulnerable_versions":">=8.0.0 <8.21.0","github_advisory_id":"GHSA-96hv-2xvq-fx4p","recommendation":"Upgrade to version 8.21.0 or later","patched_versions":">=8.21.0","updated":"2026-07-13T15:31:39.000Z","cvss":{"score":7.5,"vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H"},"cwe":["CWE-400","CWE-770","CWE-1050"],"url":"https://github.com/advisories/GHSA-96hv-2xvq-fx4p"}}}
